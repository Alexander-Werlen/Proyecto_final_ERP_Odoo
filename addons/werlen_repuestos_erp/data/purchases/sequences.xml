<odoo>
    <data noupdate="1">
        <record id="seq_purchase_invoice" model="ir.sequence">
            <field name="name">Factura de compra</field>
            <field name="code">purchase.invoice</field>
            <field name="prefix">FC-</field>
            <field name="padding">6</field>
        </record>
        <record id="seq_supplier_claim" model="ir.sequence">
            <field name="name">Reclamo a proveedor</field>
            <field name="code">supplier.claim</field>
            <field name="prefix">RP-</field>
            <field name="padding">6</field>
        </record>
        <record id="seq_return_note" model="ir.sequence">
            <field name="name">Nota de devolución</field>
            <field name="code">return.note</field>
            <field name="prefix">ND-</field>
            <field name="padding">6</field>
        </record>
    </data>
</odoo>
