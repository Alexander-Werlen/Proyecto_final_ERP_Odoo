<odoo>
    <record id="supplier_payment_destination_list_view" model="ir.ui.view">
        <field name="name">supplier.payment.destination.list</field>
        <field name="model">supplier_payment_destination</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" optional="hide"/>
                <field name="partner_id"/>
                <field name="bank_name"/>
                <field name="bank_number"/>
                <field name="account_number"/>
                <field name="cvu"/>
            </list>
        </field>
    </record>

    <record id="supplier_payment_destination_form_view" model="ir.ui.view">
        <field name="name">supplier.payment.destination.form</field>
        <field name="model">supplier_payment_destination</field>
        <field name="arch" type="xml">
            <form string="Destino de pago a proveedor">
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1" invisible="1"/>
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="bank_name"/>
                            <field name="bank_number"/>
                        </group>
                        <group>
                            <field name="account_number"/>
                            <field name="cvu"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="supplier_payment_destination_search_view" model="ir.ui.view">
        <field name="name">supplier.payment.destination.search</field>
        <field name="model">supplier_payment_destination</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="bank_name"/>
                <field name="bank_number"/>
                <field name="cvu"/>
                <field name="account_number"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Proveedor" name="group_by_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Num Banco" name="group_by_bank" context="{'group_by': 'bank_number'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_open_supplier_payment_destinations" model="ir.actions.act_window">
        <field name="name">Destinos de pago</field>
        <field name="res_model">supplier_payment_destination</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_by_partner': True}</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('werlen_repuestos_erp.supplier_payment_destination_list_view')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('werlen_repuestos_erp.supplier_payment_destination_form_view')})
        ]"/>
    </record>
</odoo>
