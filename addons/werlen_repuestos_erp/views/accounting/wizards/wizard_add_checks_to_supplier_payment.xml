<odoo>
    <record id="wizard_add_checks_to_supplier_payment_form_view" model="ir.ui.view">
        <field name="name">wizard.add.checks.to.supplier.payment.form</field>
        <field name="model">wizard_add_checks_to_supplier_payment</field>
        <field name="arch" type="xml">
            <form string="Asociar Cheques">
                <sheet>
                    <group>
                        <field name="supplier_payment_id" invisible="1"/>
                        <field name="check_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="Confirmar" class="btn btn-primary"/>
                    <button string="Cancelar" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
