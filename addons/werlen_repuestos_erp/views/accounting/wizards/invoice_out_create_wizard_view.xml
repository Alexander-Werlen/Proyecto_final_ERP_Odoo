<odoo>
    <record id="invoice_out_create_wizard_form" model="ir.ui.view">
        <field name="name">invoice.out.create.wizard.form</field>
        <field name="model">invoice_out_create_wizard</field>
        <field name="arch" type="xml">
            <form string="Crear Factura Manual">

                <h1>FACTURA</h1>

                <group>
                    <group>
                        <field name="invoice_id" placeholder="Por Ej: 0021-00008211"/>
                        <field name="invoice_type" domain="[('invoice_type_id', '=like', 'FC-%')]"/>
                        <field name="client"/>
                        <field name="full_name"/>
                    </group>
                    <group>
                        <field name="total_cost"/>
                        <field name="payment_method" domain="[('active_currently', '=', True)]"
                            options="{'no_create': True, 'no_create_edit': True}"
                        />
                        <field name="seller"/>
                        <field name="date"/>
                    </group>
                </group>

                <footer>
                    <button name="action_create_invoice"
                        type="object"
                        string="Crear y Confirmar"
                        class="btn-primary"
                        confirm="¿Está seguro de que desea crear la factura?"
                    />
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>