<odoo>
    <record id="invoice_out_create_wizard_form" model="ir.ui.view">
        <field name="name">invoice.out.create.wizard.form</field>
        <field name="model">invoice_out_create_wizard</field>
        <field name="arch" type="xml">
            <form string="Crear Factura Manual">

                <h1>FACTURA</h1>

                <div class="row g-4">
                    <div class="col-md-6">
                        <label for="invoice_id"/>
                        <field name="invoice_id" placeholder="Por Ej: 0021-00008211" class="w-100"/>
                        <label for="invoice_type"/>
                        <field name="invoice_type" domain="[('invoice_type_id', '=like', 'FC-%')]" class="w-100"/>
                        <label for="client"/>
                        <field name="client" class="w-100"/>
                        <label for="full_name"/>
                        <field name="full_name" class="w-100"/>
                    </div>
                    <div class="col-md-6">
                        <label for="total_cost"/>
                        <field name="total_cost" class="w-100"/>
                        <label for="payment_method"/>
                        <field name="payment_method" domain="[('active_currently', '=', True)]"
                            options="{'no_create': True, 'no_create_edit': True}" class="w-100"/>
                        <label for="seller"/>
                        <field name="seller" class="w-100"/>
                        <label for="date"/>
                        <field name="date" class="w-100"/>
                    </div>
                </div>

                <footer>
                    <button name="action_create_invoice"
                        type="object"
                        string="Crear y Confirmar"
                        class="btn-primary"
                        confirm="¿Está seguro de que desea crear la factura?"
                    />
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
