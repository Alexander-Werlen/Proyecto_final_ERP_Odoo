<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="wizard_bulk_delete_vouchers_form_view" model="ir.ui.view">
        <field name="name">wizard.clean.vouchers.form.view</field>
        <field name="model">wizard.clean_vouchers</field>
        <field name="arch" type="xml">
            <form string="Limpieza de Comprobantes">
                <sheet>
                    <div class="alert alert-danger" role="alert" style="margin-bottom: 16px;">
                        <h4 style="margin-top:0;">ADVERTENCIA - Acción IRREVERSIBLE</h4>
                        <p>
                            Esta herramienta realiza la limpieza de comprobantes y todos los registros asociados
                            (reconciliaciones, pagos huérfanos, órdenes de venta, cierres de caja).
                        </p>
                        <p>
                            Se aplica la regla <b>todo-o-nada por componente conexo</b>: si una reconciliación
                            une comprobantes in-scope con comprobantes fuera de la fecha de corte, el componente
                            entero se preserva para no corromper el estado de pagos.
                        </p>
                        <p>
                            <b>Asegúrese de tener un backup de la base de datos antes de continuar.</b>
                        </p>
                    </div>

                    <group>
                        <field name="sales_point"
                               placeholder="0001"
                               required="True"/>
                        <field name="cutoff_date"
                               required="True"/>
                        <field name="include_cash_sessions"/>
                        <field name="confirmation_text"
                               placeholder="Escriba LIMPIAR"
                               required="True"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_preview" type="object"
                            string="Previsualizar"
                            class="btn-secondary"
                            context="{'default_result_log': False}"/>
                    <button name="action_execute" type="object"
                            string="Ejecutar limpieza"
                            class="btn-danger"
                            confirm="¿Está SEGURO? Esta acción es IRREVERSIBLE. Asegúrese de tener un backup."/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
