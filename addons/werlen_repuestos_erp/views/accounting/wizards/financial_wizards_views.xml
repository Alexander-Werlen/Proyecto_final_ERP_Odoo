<odoo>
    <record id="wizard_manual_payment_in_journal_form_view" model="ir.ui.view">
        <field name="name">wizard.manual.payment.in.journal.form</field>
        <field name="model">wizard_manual_payment_in_journal</field>
        <field name="arch" type="xml">
            <form string="Pago Manual Entrante a Diario">
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="payer"/>
                            <field name="amount"/>
                            <field name="payment_method" domain="[('allowed_journals', 'in', journal), ('active_currently', '=', True)]"
                                options="{'no_create': True, 'no_create_edit': True}"
                            />
                        </group>
                        <group>
                            <field name="journal" readonly="1"/>
                            <field name="payment_origin_explanation"/>
                            <field name="observations"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Confirmar" type="object" name="action_confirm" data-hotkey="enter" class="oe_highlight"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="wizard_manual_payment_out_journal_form_view" model="ir.ui.view">
        <field name="name">wizard.manual.payment.out.journal.form</field>
        <field name="model">wizard_manual_payment_out_journal</field>
        <field name="arch" type="xml">
            <form string="Pago Manual Entrante a Diario">
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="payee" invisible="hide_field_payee"/>
                            <field name="amount"/>
                            <field name="payment_method" domain="[('allowed_journals', 'in', journal), ('active_currently', '=', True)]"
                                options="{'no_create': True, 'no_create_edit': True}"
                            />
                        </group>
                        <group>
                            <field name="journal" readonly="1"/>
                            <field name="payment_origin_explanation"/>
                            <field name="observations"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Confirmar" type="object" name="action_confirm" data-hotkey="enter" class="oe_highlight"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="wizard_change_payment_line_journal_form_view" model="ir.ui.view">
        <field name="name">wizard.change.payment.line.journal.form</field>
        <field name="model">wizard_change_payment_line_journal</field>
        <field name="arch" type="xml">
            <form string="Cambiar diario del Pago">
                <group>
                    <group>
                        <field name="payment_line_id" readonly="1"/>
                        <field name="payment_line_amount" readonly="1"/>
                    </group>
                    <group>
                        <field name="current_journal_id" readonly="1"/>
                        <field name="new_journal_id" options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirmar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="wizard_change_check_journal_form_view" model="ir.ui.view">
        <field name="name">wizard.change.check.journal.form</field>
        <field name="model">wizard_change_check_journal</field>
        <field name="arch" type="xml">
            <form string="Cambiar diario del cheque">
                <group>
                    <group>
                        <field name="check_id" readonly="1"/>
                        <field name="check_amount" readonly="1"/>
                    </group>
                    <group>
                        <field name="current_journal_id" readonly="1"/>
                        <field name="new_journal_id" options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirmar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="wizard_payment_line_out_credit_note_form_view" model="ir.ui.view">
        <field name="name">wizard.out.payment.line.credit.note.form</field>
        <field name="model">wizard_payment_line_out_credit_note</field>
        <field name="arch" type="xml">
            <form string="Pago Saliente">
                <sheet>
                    <group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount"/>
                            <field name="payment_method" domain="[('active_currently', '=', True)]"
                                options="{'no_create': True, 'no_create_edit': True}"
                            />
                            <field name="journal" options="{'no_create': True, 'no_create_edit': True}"/>
                        </group>
                        <group>
                            <div invisible="credit_note_out_id == False">
                                <div class="o_row" style="font-size: 14px;">
                                    <span><strong>Importe faltante: </strong></span>
                                    <field name="credit_note_out_amount_not_reconciliated" readonly="1" nolabel="1" class="ml-1"/>
                                </div>
                                <div class="o_row" style="font-size: 14px;">
                                    <span>Importe de la nota de crédito: </span>
                                    <field name="credit_note_out_total_amount" readonly="1" nolabel="1" class="ml-1"/>
                                </div>
                                <div class="o_row" style="font-size: 14px;">
                                    <span>Pago para </span>
                                    <field name="credit_note_out_id" readonly="1" nolabel="1" class="ml-1"/>
                                </div>
                            </div>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Confirmar" type="object" name="action_confirm" data-hotkey="enter" class="oe_highlight"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="wizard_verification_credit_note_out_form_view" model="ir.ui.view">
        <field name="name">wizard.verification.credit.note.out</field>
        <field name="model">wizard_verification_credit_note_out</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="credit_note_id"/>
                        <field name="full_name"/>
                        <field name="total_amount"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="seller_of_related_invoice"/>
                        <field name="date"/>
                    </group>
                </group>
                <group string="Datos a Completar">
                    <group>
                        <field name="who_created"/>
                        <field name="who_approved"/>
                    </group>
                    <group>
                        <field name="skip_related_invoice" widget="boolean_toggle"/>
                        <field name="related_invoice" invisible="skip_related_invoice"/>
                    </group>
                </group>
                <field name="observations" placeholder="Observaciones..."/>
                <footer>
                    <button string="Confirmar" type="object" name="action_confirm_verification" data-hotkey="enter" class="oe_highlight"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="wizard_create_credit_note_out_form_view" model="ir.ui.view">
        <field name="name">create.credit.note.out.form</field>
        <field name="model">wizard_create_credit_note_out</field>
        <field name="arch" type="xml">
            <form string="Nota de Crédito" create="false" delete="false">
                <h1>NOTA DE CRÉDITO</h1>
                <group>
                    <group>
                        <field name="credit_note_id" placeholder="Por Ej: 0021-00008211"/>
                        <field name="invoice_type" domain="[('invoice_type_id', '=like', 'NC-%')]"/>
                        <field name="client"/>
                        <field name="full_name"/>
                    </group>
                    <group>
                        <field name="total_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="payment_method" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="seller_of_related_invoice"/>
                        <field name="date"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm_draft" type="object" string="Crear" class="oe_highlight"
                        confirm="¿Está seguro de que desea crear la nota de crédito?"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="wizard_create_account_payment_form_view" model="ir.ui.view">
        <field name="name">wizard.create.account.payment.form</field>
        <field name="model">wizard_create_account_payment</field>
        <field name="arch" type="xml">
            <form string="Crear Recibo Manual">
                <h1>RECIBO</h1>
                <group>
                    <group>
                        <field name="account_payment_id" placeholder="Ej: RC-B-0001-00001234"/>
                        <field name="client"/>
                        <field name="date"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="amount"/>
                        <field name="discount_amount"/>
                    </group>
                </group>
                <footer>
                    <button name="action_create_account_payment" type="object" string="Crear Recibo" class="btn-primary"
                        confirm="¿Está seguro de que desea crear el recibo?"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="wizard_current_account_income_form_view" model="ir.ui.view">
        <field name="name">wizard.current.account.income.form</field>
        <field name="model">wizard_current_account_income</field>
        <field name="arch" type="xml">
            <form string="Ingreso a Cuenta Corriente">
                <sheet>
                        <field name="currency_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="amount"/>
                            <field name="payment_method_id"
                                options="{'no_create': True, 'no_create_edit': True}"
                                domain="[('active_currently', '=', True)]"
                            />
                            <field name="journal_id"/>
                        </group>
                        <group>
                            <field name="payer_id" string="Cliente"/>
                            <field name="payment_origin_explanation"/>
                            <field name="account_payment_for_auto_reconciliation" invisible="not account_payment_for_auto_reconciliation"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Observaciones">
                            <field name="observations"/>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button string="Crear Pago" type="object" name="action_create_payment_line" data-hotkey="enter" class="oe_highlight"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="wizard_verification_account_payment_form_view" model="ir.ui.view">
        <field name="name">wizard.verification.account.payment.form</field>
        <field name="model">wizard_verification_account_payment</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="account_payment"/>
                        <field name="date"/>
                        <field name="client"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="amount"/>
                        <field name="discount_amount"/>
                    </group>
                </group>
                <group string="Datos a Completar">
                    <group>
                        <field name="related_payments" string="Pagos Relacionados" widget="many2many_tags"/>
                        <field name="related_checks" string="Cheques Relacionados" widget="many2many_tags"/>
                        <field name="who_created"/>
                    </group>
                    <group>
                        <field name="amount_reconciliated"/>
                        <field name="amount_not_reconciliated"/>
                    </group>
                </group>
                <field name="observations" placeholder="Observaciones..."/>
                <footer>
                    <button string="Confirmar" type="object" name="action_confirm_verification" data-hotkey="enter" class="oe_highlight"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="wizard_payment_line_day_summary_view" model="ir.ui.view">
        <field name="name">payment.line.day.wizard.form</field>
        <field name="model">wizard_payment_line_day_summary</field>
        <field name="arch" type="xml">
            <form string="Resumen de Movimientos por día">
                <group>
                    <field name="date"/>
                </group>
                <footer>
                    <button name="action_open_lines" string="Ver movimientos" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="wizard_close_cash_session_form_view" model="ir.ui.view">
        <field name="name">wizard.close.cash.session.form.view</field>
        <field name="model">wizard_close_cash_session</field>
        <field name="arch" type="xml">
            <form string="Cierre de Caja">
                <sheet>
                    <field name="line_ids">
                        <list editable="bottom" create="0" delete="0">
                            <field name="category_id" readonly="1"/>
                            <field name="theoretical_balance" readonly="1"/>
                            <field name="counted_balance" class="fw-bold text-dark"/>
                            <field name="currency_id" column_invisible="True" readonly="1"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_confirm_close" type="object"
                        string="Confirmar Cierre"
                        class="btn-primary"
                        confirm="¿Estás seguro de que deseas cerrar la caja? Esta acción es definitiva."
                    />
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="wizard_manual_payment_invoice_out_form_view" model="ir.ui.view">
        <field name="name">wizard.manual.payment.invoice.out.form.view</field>
        <field name="model">wizard_manual_payment_invoice_out</field>
        <field name="arch" type="xml">
            <form string="Pago Entrante">
                <sheet>
                    <group>
                        <group>
                        <field name="currency_id" invisible="1"/>
                            <field name="amount"/>
                            <field name="payment_method" domain="[('active_currently', '=', True)]"
                                options="{'no_create': True, 'no_create_edit': True}"
                            />
                            <field name="journal" domain="[('allowed_payment_methods', 'in', payment_method)]"
                                options="{'no_create': True, 'no_create_edit': True}"
                            />
                        </group>
                        <group>
                            <div>
                                <div class="o_row fw-bold text-dark" style="font-size: 14px;">
                                    <span><strong>Importe faltante: </strong></span>
                                    <field name="invoice_out_amount_not_reconciliated" readonly="1" nolabel="1" class="ml-1 fw-bold text-dark"/>
                                </div>
                                <div class="o_row" style="font-size: 14px;">
                                    <span>Importe de la factura: </span>
                                    <field name="invoice_out_total_amount" readonly="1" nolabel="1" class="ml-1"/>
                                </div>
                                <div class="o_row" style="font-size: 14px;">
                                    <span>Pago para </span>
                                    <field name="reconciliation_invoice_id" readonly="1" nolabel="1" class="ml-1"/>
                                </div>
                            </div>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Confirmar" type="object" name="action_confirm" data-hotkey="enter" class="oe_highlight"/>
                    <button string="Cancelar" data-hotkey="c" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
