<odoo>
    <record id="wizard_manual_payment_in_journal_form_view" model="ir.ui.view">
        <field name="name">wizard.manual.payment.in.journal.form</field>
        <field name="model">wizard_manual_payment_in_journal</field>
        <field name="arch" type="xml">
            <form string="Pago Manual Entrante a Diario">
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="payer"/>
                            <field name="amount"/>
                            <field name="payment_method" domain="[('allowed_journals', 'in', journal), ('active_currently', '=', True)]"
                                options="{'no_create': True, 'no_create_edit': True}"
                            />
                        </group>
                        <group>
                            <field name="journal" readonly="1"/>
                            <field name="payment_origin_explanation"/>
                            <field name="observations"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Confirmar" type="object" name="action_confirm" data-hotkey="enter" class="oe_highlight"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="wizard_manual_payment_out_journal_form_view" model="ir.ui.view">
        <field name="name">wizard.manual.payment.out.journal.form</field>
        <field name="model">wizard_manual_payment_out_journal</field>
        <field name="arch" type="xml">
            <form string="Pago Manual Entrante a Diario">
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="payee" invisible="hide_field_payee"/>
                            <field name="amount"/>
                            <field name="payment_method" domain="[('allowed_journals', 'in', journal), ('active_currently', '=', True)]"
                                options="{'no_create': True, 'no_create_edit': True}"
                            />
                        </group>
                        <group>
                            <field name="journal" readonly="1"/>
                            <field name="payment_origin_explanation"/>
                            <field name="observations"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Confirmar" type="object" name="action_confirm" data-hotkey="enter" class="oe_highlight"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="wizard_change_payment_line_journal_form_view" model="ir.ui.view">
        <field name="name">wizard.change.payment.line.journal.form</field>
        <field name="model">wizard_change_payment_line_journal</field>
        <field name="arch" type="xml">
            <form string="Cambiar diario del Pago">
                <group>
                    <group>
                        <field name="payment_line_id" readonly="1"/>
                        <field name="payment_line_amount" readonly="1"/>
                    </group>
                    <group>
                        <field name="current_journal_id" readonly="1"/>
                        <field name="new_journal_id" options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirmar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="wizard_change_check_journal_form_view" model="ir.ui.view">
        <field name="name">wizard.change.check.journal.form</field>
        <field name="model">wizard_change_check_journal</field>
        <field name="arch" type="xml">
            <form string="Cambiar diario del cheque">
                <group>
                    <group>
                        <field name="check_id" readonly="1"/>
                        <field name="check_amount" readonly="1"/>
                    </group>
                    <group>
                        <field name="current_journal_id" readonly="1"/>
                        <field name="new_journal_id" options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirmar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="wizard_payment_line_out_credit_note_form_view" model="ir.ui.view">
        <field name="name">wizard.out.payment.line.credit.note.form</field>
        <field name="model">wizard_payment_line_out_credit_note</field>
        <field name="arch" type="xml">
            <form string="Pago Saliente">
                <sheet>
                    <group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount"/>
                            <field name="payment_method" domain="[('active_currently', '=', True)]"
                                options="{'no_create': True, 'no_create_edit': True}"
                            />
                            <field name="journal" options="{'no_create': True, 'no_create_edit': True}"/>
                        </group>
                        <group>
                            <div invisible="credit_note_out_id == False">
                                <div class="o_row" style="font-size: 14px;">
                                    <span><strong>Importe faltante: </strong></span>
                                    <field name="credit_note_out_amount_not_reconciliated" readonly="1" nolabel="1" class="ml-1"/>
                                </div>
                                <div class="o_row" style="font-size: 14px;">
                                    <span>Importe de la nota de crédito: </span>
                                    <field name="credit_note_out_total_amount" readonly="1" nolabel="1" class="ml-1"/>
                                </div>
                                <div class="o_row" style="font-size: 14px;">
                                    <span>Pago para </span>
                                    <field name="credit_note_out_id" readonly="1" nolabel="1" class="ml-1"/>
                                </div>
                            </div>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Confirmar" type="object" name="action_confirm" data-hotkey="enter" class="oe_highlight"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="wizard_verification_credit_note_out_form_view" model="ir.ui.view">
        <field name="name">wizard.verification.credit.note.out</field>
        <field name="model">wizard_verification_credit_note_out</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="credit_note_id"/>
                        <field name="full_name"/>
                        <field name="total_amount"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="seller_of_related_invoice"/>
                        <field name="date"/>
                    </group>
                </group>
                <group string="Datos a Completar">
                    <group>
                        <field name="who_created"/>
                        <field name="who_approved"/>
                    </group>
                    <group>
                        <field name="skip_related_invoice" widget="boolean_toggle"/>
                        <field name="related_invoice" invisible="skip_related_invoice"/>
                    </group>
                </group>
                <field name="observations" placeholder="Observaciones..."/>
                <footer>
                    <button string="Confirmar" type="object" name="action_confirm_verification" data-hotkey="enter" class="oe_highlight"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="wizard_create_credit_note_out_form_view" model="ir.ui.view">
        <field name="name">wizard.create.credit.note.out.form</field>
        <field name="model">wizard_create_credit_note_out</field>
        <field name="arch" type="xml">
            <form string="Crear nota de crédito">
                <div class="row g-4">
                    <div class="col-md-6">
                        <label for="credit_note_id"/>
                        <field name="credit_note_id" class="w-100"/>
                        <label for="invoice_type"/>
                        <field name="invoice_type" domain="[('invoice_type_id', '=like', 'NC-%')]" class="w-100"/>
                        <label for="client"/>
                        <field name="client" class="w-100"/>
                        <label for="full_name"/>
                        <field name="full_name" class="w-100"/>
                    </div>
                    <div class="col-md-6">
                        <field name="currency_id" invisible="1"/>
                        <label for="total_amount"/>
                        <field name="total_amount" class="w-100"/>
                        <label for="payment_method"/>
                        <field name="payment_method" domain="[('active_currently', '=', True)]" class="w-100"/>
                        <label for="seller_of_related_invoice"/>
                        <field name="seller_of_related_invoice" class="w-100"/>
                        <label for="date"/>
                        <field name="date" class="w-100"/>
                    </div>
                </div>
                <footer>
                    <button name="action_confirm_draft" type="object" string="Crear" class="oe_highlight"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="wizard_create_account_payment_form_view" model="ir.ui.view">
        <field name="name">wizard.create.account.payment.form</field>
        <field name="model">wizard_create_account_payment</field>
        <field name="arch" type="xml">
            <form string="Crear recibo">
                <div class="row g-4">
                    <div class="col-md-6">
                        <label for="account_payment_id"/>
                        <field name="account_payment_id" class="w-100"/>
                        <label for="client"/>
                        <field name="client" class="w-100"/>
                        <label for="date"/>
                        <field name="date" class="w-100"/>
                    </div>
                    <div class="col-md-6">
                        <field name="currency_id" invisible="1"/>
                        <label for="amount"/>
                        <field name="amount" class="w-100"/>
                        <label for="discount_amount"/>
                        <field name="discount_amount" class="w-100"/>
                    </div>
                </div>
                <footer>
                    <button name="action_create_account_payment" type="object" string="Crear" class="oe_highlight"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="wizard_current_account_income_form_view" model="ir.ui.view">
        <field name="name">wizard.current.account.income.form</field>
        <field name="model">wizard_current_account_income</field>
        <field name="arch" type="xml">
            <form string="Ingreso a cuenta corriente">
                <div class="row g-4">
                    <div class="col-md-6">
                        <label for="amount"/>
                        <field name="amount" class="w-100"/>
                        <label for="payment_method_id"/>
                        <field name="payment_method_id" class="w-100"/>
                        <label for="journal_id"/>
                        <field name="journal_id" domain="[('allowed_payment_methods', 'in', payment_method_id)]" class="w-100"/>
                    </div>
                    <div class="col-md-6">
                        <field name="currency_id" invisible="1"/>
                        <label for="payer_id"/>
                        <field name="payer_id" readonly="1" string="Cliente" class="w-100"/>
                        <label for="payment_origin_explanation"/>
                        <field name="payment_origin_explanation" invisible="not payment_origin_explanation" class="w-100"/>
                    </div>
                </div>
                <separator string="Observaciones"/>
                <field name="observations" nolabel="1" class="w-100"/>
                <footer>
                    <button name="action_create_payment_line" type="object" string="Registrar" class="oe_highlight"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="wizard_verification_account_payment_form_view" model="ir.ui.view">
        <field name="name">wizard.verification.account.payment.form</field>
        <field name="model">wizard_verification_account_payment</field>
        <field name="arch" type="xml">
            <form string="Verificar recibo">
                <div class="row g-4">
                    <div class="col-md-6">
                        <label for="account_payment"/>
                        <field name="account_payment" readonly="1" class="w-100"/>
                        <label for="date"/>
                        <field name="date" readonly="1" class="w-100"/>
                        <label for="client"/>
                        <field name="client" readonly="1" class="w-100"/>
                    </div>
                    <div class="col-md-6">
                        <field name="currency_id" invisible="1"/>
                        <label for="amount"/>
                        <field name="amount" readonly="1" class="w-100"/>
                        <label for="discount_amount"/>
                        <field name="discount_amount" readonly="1" class="w-100"/>
                    </div>
                </div>

                <separator string="Datos a Completar"/>
                <div class="row g-4">
                    <div class="col-md-6">
                        <label for="related_payments"/>
                        <field name="related_payments" string="Pagos Relacionados" widget="many2many_tags" class="w-100"/>
                        <label for="related_checks"/>
                        <field name="related_checks" string="Cheques Relacionados" widget="many2many_tags" class="w-100"/>
                        <label for="who_created"/>
                        <field name="who_created" class="w-100"/>
                    </div>
                    <div class="col-md-6">
                        <label for="amount_reconciliated"/>
                        <field name="amount_reconciliated" readonly="1" class="w-100"/>
                        <label for="amount_not_reconciliated"/>
                        <field name="amount_not_reconciliated" readonly="1" class="w-100"/>
                    </div>
                </div>
                <label for="observations"/>
                <field name="observations" placeholder="Observaciones..." class="w-100"/>
                <footer>
                    <button name="action_confirm_verification" type="object" string="Verificar" class="oe_highlight"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="wizard_payment_line_day_summary_view" model="ir.ui.view">
        <field name="name">wizard.payment.line.day.summary.form</field>
        <field name="model">wizard_payment_line_day_summary</field>
        <field name="arch" type="xml">
            <form string="Resumen de movimientos">
                <group><field name="date"/></group>
                <footer>
                    <button name="action_open_lines" type="object" string="Ver movimientos" class="oe_highlight"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="wizard_close_cash_session_form_view" model="ir.ui.view">
        <field name="name">wizard.close.cash.session.form</field>
        <field name="model">wizard_close_cash_session</field>
        <field name="arch" type="xml">
            <form string="Cerrar caja">
                <group>
                    <field name="cash_session_id" readonly="1"/>
                    <field name="journal_id" readonly="1"/>
                    <field name="currency_id" invisible="1"/>
                </group>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="category_id" readonly="1"/>
                        <field name="opening_balance" readonly="1"/>
                        <field name="movements_amount" readonly="1"/>
                        <field name="theoretical_balance" readonly="1"/>
                        <field name="counted_balance"/>
                        <field name="difference" readonly="1"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm_close" type="object" string="Cerrar caja" class="oe_highlight"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="wizard_manual_payment_invoice_out_form_view" model="ir.ui.view">
        <field name="name">wizard.manual.payment.invoice.out.form</field>
        <field name="model">wizard_manual_payment_invoice_out</field>
        <field name="arch" type="xml">
            <form string="Registrar pago de factura">
                <div class="row g-4">
                    <div class="col-md-6">
                        <label for="reconciliation_invoice_id"/>
                        <field name="reconciliation_invoice_id" readonly="1" class="w-100"/>
                        <label for="invoice_out_total_amount"/>
                        <field name="invoice_out_total_amount" readonly="1" class="w-100"/>
                        <label for="invoice_out_amount_not_reconciliated"/>
                        <field name="invoice_out_amount_not_reconciliated" readonly="1" class="w-100"/>
                    </div>
                    <div class="col-md-6">
                        <field name="currency_id" invisible="1"/>
                        <label for="amount"/>
                        <field name="amount" class="w-100"/>
                        <label for="payer"/>
                        <field name="payer" readonly="1" class="w-100"/>
                        <label for="payment_method"/>
                        <field name="payment_method" class="w-100"/>
                        <label for="journal"/>
                        <field name="journal" domain="[('allowed_payment_methods', 'in', payment_method)]" class="w-100"/>
                    </div>
                </div>
                <footer>
                    <button name="action_confirm" type="object" string="Registrar" class="oe_highlight"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
