<odoo>
    <record id="supplier_payment_method_list_view" model="ir.ui.view">
        <field name="name">supplier.payment.method.list</field>
        <field name="model">supplier_payment_method</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="account_number"/>
            </list>
        </field>
    </record>

    <record id="supplier_payment_method_form_view" model="ir.ui.view">
        <field name="name">supplier.payment.method.form</field>
        <field name="model">supplier_payment_method</field>
        <field name="arch" type="xml">
            <form string="Método de pago a proveedor">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="account_number"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_open_supplier_payment_methods" model="ir.actions.act_window">
        <field name="name">Métodos de pago a Proveedor</field>
        <field name="res_model">supplier_payment_method</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('werlen_repuestos_erp.supplier_payment_method_list_view')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('werlen_repuestos_erp.supplier_payment_method_form_view')})
        ]"/>
    </record>
</odoo>
