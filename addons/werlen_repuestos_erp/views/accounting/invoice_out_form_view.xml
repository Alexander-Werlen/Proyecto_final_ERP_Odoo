<odoo>
    <data>
        <record id="invoice_out_form_view" model="ir.ui.view">
            <field name="name">Invoice Out Form View</field>
            <field name="model">invoice_out</field>
            <field name="arch" type="xml">
                <form string="Facturas Emitidas" create="false" delete="false">
                <sheet>

                    <widget name="web_ribbon" title="Borrador"
                        bg_color="bg-danger" invisible="is_draft == False"
                    />
                    <widget name="web_ribbon" title="No Reconciliado"
                        bg_color="bg-danger" invisible="payment_status != 'not_paid'"
                    />
                    <widget name="web_ribbon" title="Rec. Parcial"
                        bg_color="bg-warning" invisible="payment_status != 'partially_paid'"
                    />
                    <widget name="web_ribbon" title="Reconciliado"
                        bg_color="bg-success" invisible="payment_status != 'paid'"
                    />
                    <widget name="web_ribbon" title="Cuenta-Corriente"
                        bg_color="bg-info" invisible="payment_status != 'account'"
                    />

                    <h1>
                    FACTURA EMITIDA
                    </h1>
                    <group>
                        <group>
                            <field name="currency_id" readonly="1" invisible="1"/>
                            <field name="invoice_id" readonly="is_draft == False"/>
                            <field name="invoice_type" domain="[('invoice_type_id', '=like', 'FC-%')]" readonly="is_draft == False"/>
                            <field name="client" readonly="is_draft == False"/>
                            <field name="full_name" readonly="is_draft == False"/>
                        </group>
                        <group>
                            <field name="total_cost" readonly="is_draft == False"/>
                            <field name="billing_base_amount" readonly="1" invisible="is_draft"/>
                            <field name="payment_method" readonly="is_draft == False"/>
                        </group>
                    </group>

                    <group string="Información general">
                        <group>
                            <field name="seller" readonly="is_draft == False"/>
                            <field name="date" readonly="is_draft == False"/>
                        </group>
                        <group>
                            <field name="state" readonly="is_draft == False"/>
                            <field name="city" readonly="is_draft == False"/>
                            <field name="destination" readonly="is_draft == False" string="Dirección"/>
                            <field name="cellphone" readonly="is_draft == False"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Observaciones">
                            <field name="observations"/>
                        </page>
                        <page string="Info Creación">
                            <group>
                                <field name="is_manual_invoice" readonly="true" widget="boolean_toggle"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
