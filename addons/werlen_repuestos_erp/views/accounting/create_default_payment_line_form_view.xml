<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="create_default_payment_line_form_view" model="ir.ui.view">
        <field name="name">payment.line.form</field>
        <field name="model">payment_line</field>
        <field name="arch" type="xml">
            <form string="Nuevo Pago"
                  create="false"
                  delete="false">

                <sheet>
                    <h1>INFORMACIÓN DEL PAGO</h1>
                    <group>
                        <group>
                            <field name="amount"
                                    widget="monetary"
                                    options="{'currency_field': 'currency_id'}"/>
                            <field name="is_outgoing" widget="boolean_toggle"/>
                            <field name="currency_id" readonly="1" invisible="1"/>
                            <field name="payment_method" domain="[('active_currently', '=', True)]"/>
                            <field name="journal"/>
                        </group>
                        <group>
                            <field name="confirmed"/>
                            <field name="payment_origin_explanation"/>
                            <field name="payer"/>
                            <field name="payee"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Observaciones">
                            <field name="observations"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
