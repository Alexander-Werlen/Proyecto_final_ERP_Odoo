<odoo>
    <record id="default_payment_line_list_view" model="ir.ui.view">
        <field name="name">payment.line.list</field>
        <field name="model">payment_line</field>
        <field name="arch" type="xml">
            <list string="Pagos" create="false" edit="false" delete="false" decoration-danger="confirmed == False" default_order="time_of_payment_confirmation desc">
                <field name="payment_origin_explanation" widget="badge" decoration-muted="payment_origin_explanation == 'cash_session_closure'" decoration-info="payment_origin_explanation == 'account_in'" decoration-warning="payment_origin_explanation in ['non_operational']"/>
                <field name="payer" string="Paga"/>
                <field name="name" string="Referencia" optional="hide"/>
                <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="payment_method" string="Método"/>
                <field name="journal" string="Diario" optional="hide"/>
                <field name="observations" string="Observaciones" optional="show"/>
                <field name="is_outgoing" string="Es Saliente" widget="boolean_toggle"/>
                <field name="confirmed" string="Confirmado" widget="boolean_toggle" optional="hide"/>
                <field name="who_proposed_payment" optional="hide"/>
                <field name="time_of_payment_proposal" optional="hide"/>
                <field name="who_confirmed_payment" optional="hide"/>
                <field name="time_of_payment_confirmation" optional="hide"/>
                <field name="payment_status" widget="badge" decoration-danger="payment_status == 'not_paid'" decoration-warning="payment_status == 'partially_paid'" decoration-success="payment_status == 'paid'" width="100px" string="Reconciliación"/>
            </list>
        </field>
    </record>

    <record id="default_payment_line_search_view" model="ir.ui.view">
        <field name="name">payment.line.search</field>
        <field name="model">payment_line</field>
        <field name="arch" type="xml">
            <search string="Buscar pagos">
                <field name="name"/>
                <field name="payer"/>
                <field name="payee"/>
                <field name="payment_method"/>
                <field name="journal"/>
                <field name="payment_origin_explanation"/>
                <filter name="confirmed" string="Confirmados" domain="[('confirmed', '=', True)]"/>
                <filter name="not_confirmed" string="No confirmados" domain="[('confirmed', '=', False)]"/>
                <filter name="pending_reconciliation" string="Pendientes" domain="[('payment_status', 'in', ['not_paid', 'partially_paid'])]"/>
                <filter name="account_in" string="Ingresos a cuenta corriente" domain="[('payment_origin_explanation', '=', 'account_in')]"/>
                <group string="Agrupar por">
                    <filter name="group_origin" string="Razón" context="{'group_by': 'payment_origin_explanation'}"/>
                    <filter name="group_method" string="Método" context="{'group_by': 'payment_method'}"/>
                    <filter name="group_journal" string="Diario" context="{'group_by': 'journal'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="default_payment_line_form_view" model="ir.ui.view">
        <field name="name">payment.line.form</field>
        <field name="model">payment_line</field>
        <field name="arch" type="xml">
            <form string="Pago" create="false" delete="false">
                <header>
                    <button name="confirm_payment" type="object" class="btn btn-primary" string="Confirmar" groups="werlen_repuestos_erp.group_accountant" invisible="confirmed"/>
                    <button name="action_open_change_journal_wizard" type="object" class="btn btn-outline-secondary" string="Cambiar Diario" groups="werlen_repuestos_erp.group_management"/>
                    <button name="try_undo_last_step" type="object" class="btn btn-outline-danger" string="Deshacer" groups="werlen_repuestos_erp.group_accountant" confirm="¿Está seguro de que desea deshacer la confirmación o creación del pago?"/>
                    <field name="payment_status" widget="statusbar" statusbar_visible="not_paid,partially_paid,paid" invisible="payment_status == 'account'"/>
                    <field name="payment_status" widget="statusbar" statusbar_visible="account" invisible="payment_status != 'account'"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="No Confirmado" bg_color="bg-danger" invisible="confirmed == True"/>
                    <widget name="web_ribbon" title="Confirmado" bg_color="bg-success" invisible="confirmed == False"/>
                    <h1>INFORMACIÓN DEL PAGO</h1>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="amount" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="is_outgoing" readonly="1" widget="boolean_toggle"/>
                            <field name="currency_id" readonly="1" invisible="1"/>
                            <field name="payment_method" readonly="1" options="{'no_open': True}"/>
                            <field name="journal" readonly="1" options="{'no_open': True}"/>
                        </group>
                        <group>
                            <field name="payment_origin_explanation" readonly="1"/>
                            <field name="payer" readonly="1" options="{'no_open': True}"/>
                            <field name="payee" readonly="1" options="{'no_open': True}"/>
                        </group>
                    </group>
                    <separator string="Auditoría"/>
                    <group>
                        <group>
                            <field name="who_proposed_payment" readonly="1" options="{'no_open': True}"/>
                            <field name="time_of_payment_proposal" readonly="1"/>
                        </group>
                        <group>
                            <field name="who_confirmed_payment" readonly="1" options="{'no_open': True}"/>
                            <field name="time_of_payment_confirmation" readonly="1"/>
                        </group>
                    </group>
                    <separator string="Reconciliaciones"/>
                    <field name="reconciliation_lines" readonly="1">
                        <list create="false" edit="false" delete="false">
                            <field name="amount" sum="Total"/>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="outgoing_move_ref"/>
                            <field name="incomming_move_ref"/>
                            <field name="auxiliar_is_confirmed"/>
                        </list>
                    </field>
                    <notebook>
                        <page string="Observaciones">
                            <field name="observations"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="reconciliation_line_list_view" model="ir.ui.view">
        <field name="name">reconciliation.line.list</field>
        <field name="model">reconciliation_line</field>
        <field name="arch" type="xml">
            <list string="Líneas de reconciliación" create="0" edit="0" delete="0">
                <field name="amount" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="outgoing_move_ref"/>
                <field name="incomming_move_ref"/>
                <field name="confirmed" widget="boolean_toggle"/>
                <field name="auxiliar_is_confirmed"/>
            </list>
        </field>
    </record>

    <record id="manual_reconciliation_line_form_view" model="ir.ui.view">
        <field name="name">manual.reconciliation.line.form</field>
        <field name="model">transient_reconciliation_line</field>
        <field name="arch" type="xml">
            <form string="Reconciliación manual">
                <group>
                    <field name="outgoing_move_ref"/>
                    <field name="incomming_move_ref"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="outgoing_move_amount_not_reconciliated" readonly="1"/>
                    <field name="incomming_move_amount_not_reconciliated" readonly="1"/>
                    <field name="amount"/>
                </group>
                <footer>
                    <button name="create_manual_reconciliation_line" type="object" string="Reconciliar" class="oe_highlight"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="default_check_list_view" model="ir.ui.view">
        <field name="name">default.check.list</field>
        <field name="model">check</field>
        <field name="arch" type="xml">
            <list string="Cheques" default_order="time_of_creation desc">
                <field name="bank" string="Banco"/>
                <field name="check_number" string="Número"/>
                <field name="issuer" string="Emisor"/>
                <field name="owner_of_credit" string="Propietario del Crédito"/>
                <field name="payment_origin_explanation" string="Razón de Pago" optional="hide"/>
                <field name="collection_date" string="Fecha de cobro"/>
                <field name="amount"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="time_of_creation" optional="hide"/>
                <field name="payment_status" string="Estado Reconciliación" widget="badge" width="120px" decoration-danger="payment_status == 'not_paid'" decoration-warning="payment_status == 'partially_paid'" decoration-success="payment_status == 'paid'"/>
            </list>
        </field>
    </record>

    <record id="default_check_search_view" model="ir.ui.view">
        <field name="name">check.search</field>
        <field name="model">check</field>
        <field name="arch" type="xml">
            <search string="Buscar cheques">
                <field name="display_name"/>
                <field name="check_number"/>
                <field name="bank"/>
                <field name="issuer"/>
                <field name="owner_of_credit"/>
                <field name="journal_id"/>
                <filter name="pending" string="Pendientes" domain="[('payment_status', 'in', ['not_paid', 'partially_paid'])]"/>
            </search>
        </field>
    </record>

    <record id="default_check_form_view" model="ir.ui.view">
        <field name="name">default.check.form</field>
        <field name="model">check</field>
        <field name="arch" type="xml">
            <form string="Cheque" create="false">
                <header>
                    <button name="action_open_change_journal_wizard" type="object" class="btn btn-outline-secondary" string="Cambiar Diario" groups="werlen_repuestos_erp.group_management"/>
                    <field name="payment_status" widget="statusbar" statusbar_visible="not_paid,partially_paid,paid" invisible="payment_status == 'account'"/>
                    <field name="payment_status" widget="statusbar" statusbar_visible="account" invisible="payment_status != 'account'"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Reconciliado" bg_color="bg-success" invisible="payment_status != 'paid' or not id"/>
                    <widget name="web_ribbon" title="Rec. Parcial" bg_color="bg-warning" invisible="payment_status != 'partially_paid' or not id"/>
                    <widget name="web_ribbon" title="No Reconciliado" bg_color="bg-danger" invisible="payment_status != 'not_paid' or not id"/>
                    <h1>CHEQUE</h1>
                    <group>
                        <field name="display_name" readonly="1"/>
                        <field name="payment_origin_explanation"/>
                        <field name="amount"/>
                        <field name="owner_of_credit"/>
                        <field name="journal_id"/>
                    </group>
                    <group string="Información del cheque">
                        <group>
                            <field name="bank"/>
                            <field name="check_number"/>
                            <field name="issuer"/>
                        </group>
                        <group>
                            <field name="city"/>
                            <field name="collection_date"/>
                        </group>
                    </group>
                    <group string="Importes" invisible="not id">
                        <group>
                            <field name="amount" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="amount_reconciliated"/>
                            <field name="amount_not_reconciliated"/>
                        </group>
                    </group>
                    <group string="Auditoría" invisible="not id">
                        <group>
                            <field name="time_of_creation"/>
                        </group>
                    </group>
                    <div invisible="not id">
                        <separator string="Pagos a proveedor asociados"/>
                        <field name="supplier_payment_ids" readonly="1">
                            <list create="false" edit="false" delete="false">
                                <field name="name"/>
                                <field name="payment_date"/>
                                <field name="supplier_id" context="{'default_is_supplier': True}"/>
                            </list>
                        </field>
                        <group>
                            <field name="previous_journal_id" readonly="1"/>
                        </group>
                    </div>
                    <separator string="Reconciliaciones" invisible="not id"/>
                    <field name="reconciliation_lines" invisible="not id">
                        <list create="false" edit="false" delete="false">
                            <field name="amount"/>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="outgoing_move_ref"/>
                            <field name="incomming_move_ref"/>
                            <field name="confirmed"/>
                        </list>
                    </field>
                    <notebook>
                        <page string="Observaciones">
                            <field name="observations"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="credit_note_out_form_view" model="ir.ui.view">
        <field name="name">credit.note.out.form</field>
        <field name="model">credit_note_out</field>
        <field name="arch" type="xml">
            <form string="Nota de crédito" create="0" delete="0">
                <header>
                    <button name="action_start_verification" type="object" string="Verificar" class="oe_highlight" groups="werlen_repuestos_erp.group_administration" invisible="state != 'draft'"/>
                    <button name="create_payment" type="object" string="Reembolsar" class="oe_highlight" groups="werlen_repuestos_erp.group_accountant" invisible="payment_status in ['paid', 'account']"/>
                    <button name="show_payment_lines" type="object" string="Ver pagos" invisible="payment_status == 'account'"/>
                    <button name="show_reconciliation_lines" type="object" string="Ver reconciliaciones" invisible="payment_status == 'account'"/>
                    <field name="payment_status" widget="statusbar" statusbar_visible="not_paid,partially_paid,paid,account"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Borrador" bg_color="bg-danger" invisible="state != 'draft'"/>
                    <group>
                        <group>
                            <field name="credit_note_id" readonly="1"/>
                            <field name="invoice_type" readonly="1"/>
                            <field name="client" readonly="1"/>
                            <field name="full_name" readonly="1"/>
                        </group>
                        <group>
                            <field name="total_amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                            <field name="billing_base_amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                            <field name="payment_method" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Importes">
                        <field name="amount_reconciliated_confirmed" readonly="1"/>
                        <field name="amount_not_reconciliated_confirmed" readonly="1"/>
                        <field name="amount_reconciliated_unconfirmed" readonly="1"/>
                        <field name="amount_not_reconciliated_unconfirmed" readonly="1"/>
                    </group>
                    <group string="Información">
                        <field name="related_invoice"/>
                        <field name="seller_of_related_invoice" readonly="1"/>
                        <field name="who_created"/>
                        <field name="who_approved"/>
                        <field name="date" readonly="1"/>
                        <field name="is_manual_invoice" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Reconciliaciones">
                            <field name="reconciliation_lines" readonly="1"/>
                        </page>
                        <page string="Observaciones">
                            <field name="observations"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="default_credit_note_out_list_view" model="ir.ui.view">
        <field name="name">credit.note.out.list</field>
        <field name="model">credit_note_out</field>
        <field name="arch" type="xml">
            <list string="Notas de crédito" create="0" delete="0" default_order="date desc">
                <field name="date"/>
                <field name="credit_note_id"/>
                <field name="client_identifier"/>
                <field name="full_name"/>
                <field name="total_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"/>
                <field name="payment_status" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="default_credit_note_out_search_view" model="ir.ui.view">
        <field name="name">credit.note.out.search</field>
        <field name="model">credit_note_out</field>
        <field name="arch" type="xml">
            <search string="Buscar notas de crédito">
                <field name="credit_note_id"/>
                <field name="client"/>
                <field name="full_name"/>
                <field name="related_invoice"/>
                <filter name="draft" string="Borrador" domain="[('state', '=', 'draft')]"/>
                <filter name="pending" string="Pendientes" domain="[('payment_status', 'in', ['not_paid', 'partially_paid'])]"/>
            </search>
        </field>
    </record>

    <record id="default_account_payment_form_view" model="ir.ui.view">
        <field name="name">default.account.payment.form</field>
        <field name="model">account_payment</field>
        <field name="arch" type="xml">
            <form string="Recibo" create="false" delete="false">
                <header>
                    <button name="action_start_verification" type="object" string="Verificar" invisible="status != 'draft'" class="oe_highlight" groups="werlen_repuestos_erp.group_accountant"/>
                    <button name="action_start_verification" type="object" string="Asociar Pagos" invisible="status == 'draft' or payment_status == 'paid'" class="oe_highlight" groups="werlen_repuestos_erp.group_accountant"/>
                    <button name="create_new_payment" type="object" string="Crear Ingreso" class="oe_highlight" invisible="payment_status in ['paid', 'account']" icon="fa-usd" groups="werlen_repuestos_erp.group_accountant"/>
                    <button name="open_manual_reconciliation_line_form" type="object" string="Reconciliar" invisible="payment_status in ['paid', 'account']" class="oe_highlight" icon="fa-random" groups="werlen_repuestos_erp.group_accountant"/>
                    <button name="show_payment_lines" type="object" string="Ver Pagos" icon="fa-eye"/>
                    <button name="show_reconciliation_lines" type="object" string="Ver Reconciliaciones" icon="fa-list"/>
                    <field name="payment_status" widget="statusbar" statusbar_visible="not_paid,partially_paid,paid"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Borrador" bg_color="bg-danger" invisible="status != 'draft'"/>
                    <widget name="web_ribbon" title="No Reconciliado" bg_color="bg-danger" invisible="payment_status != 'not_paid' or status == 'draft'"/>
                    <widget name="web_ribbon" title="Rec. Parcial" bg_color="bg-warning" invisible="payment_status != 'partially_paid' or status == 'draft'"/>
                    <widget name="web_ribbon" title="Reconciliado" bg_color="bg-success" invisible="payment_status != 'paid' or status == 'draft'"/>
                    <h1>RECIBO</h1>
                    <group>
                        <field name="account_payment_id" readonly="true"/>
                    </group>
                    <group string="Información general">
                        <group>
                            <field name="client" readonly="true"/>
                            <field name="amount" readonly="true"/>
                        </group>
                        <group>
                            <field name="date" readonly="true"/>
                            <field name="who_created"/>
                        </group>
                    </group>
                    <group string="Importes">
                        <group>
                            <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="true"/>
                            <field name="discount_amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="true"/>
                            <field name="currency_id" invisible="1" readonly="true"/>
                        </group>
                        <group>
                            <field name="amount_reconciliated_confirmed" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="amount_not_reconciliated_confirmed" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Observaciones">
                            <field name="observations"/>
                        </page>
                        <page string="Reconciliaciones">
                            <field name="reconciliation_lines"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="default_account_payment_list_view" model="ir.ui.view">
        <field name="name">default.account.payment.list</field>
        <field name="model">account_payment</field>
        <field name="arch" type="xml">
            <list string="Recibos" delete="false" create="false" default_order="date desc">
                <field name="status" widget="badge" decoration-danger="status == 'draft'" decoration-success="status == 'verified'" width="100px" string="Estado"/>

                <field name="date"/>

                <field name="account_payment_id" string="Identificador"/>

                <field name="client"/>

                <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>

                <field name="currency_id" column_invisible="True"/>

                <field name="payment_status" widget="badge" decoration-danger="payment_status == 'not_paid'" decoration-warning="payment_status == 'partially_paid'" decoration-success="payment_status == 'paid'" width="100px" string="Reconciliación"/>
            </list>
        </field>
    </record>

    <record id="default_account_payment_search_view" model="ir.ui.view">
        <field name="name">account.payment.search</field>
        <field name="model">account_payment</field>
        <field name="arch" type="xml">
            <search string="Buscar recibos">
                <field name="account_payment_id"/>
                <field name="client"/>
                <field name="status"/>
                <filter name="draft" string="Borradores" domain="[('status', '=', 'draft')]"/>
                <filter name="pending" string="Pendientes" domain="[('payment_status', 'in', ['not_paid', 'partially_paid'])]"/>
                <filter name="main_category" string="Punto de venta principal" domain="[('is_main_point_of_sale_category', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="default_journal_list_view" model="ir.ui.view">
        <field name="name">default.journal.list</field>
        <field name="model">journal</field>
        <field name="arch" type="xml">
            <list string="Diarios Contables">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="default_journal_form_view" model="ir.ui.view">
        <field name="name">default.journal.form</field>
        <field name="model">journal</field>
        <field name="arch" type="xml">
            <form string="Diario" create="false" delete="false">
                <header>
                    <button name="action_manual_in_payment" type="object" string="Ingreso Manual" class="oe_highlight" icon="fa-plus-circle" confirm="¿Estás seguro de que deseas realizar un ingreso manual?" groups="werlen_repuestos_erp.group_accountant"/>
                    <button name="action_manual_out_payment" type="object" string="Egreso Manual" class="oe_highlight" icon="fa-minus-circle" confirm="¿Estás seguro de que deseas realizar un egreso manual?" groups="werlen_repuestos_erp.group_accountant"/>
                    <button name="action_create_cash_session" type="object" string="Abrir Caja" groups="werlen_repuestos_erp.group_accountant"/>
                    <button name="action_open_cash_session_form" type="object" string="Ir a Cierre de Caja" icon="fa-bar-chart" groups="werlen_repuestos_erp.group_management"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre del diario"/>
                        </h1>
                    </div>
                    <notebook>
                        <page string="Configuración">
                            <group col="2">
                                <group>
                                    <field name="allowed_payment_methods" widget="many2many_tags" options="{'no_create': True}"/>
                                </group>
                            </group>
                        </page>
                        <page string="Seguridad" groups="werlen_repuestos_erp.group_management">
                            <group col="2">
                                <group>
                                    <field name="allowed_users" widget="many2many_tags" options="{'no_create': True}"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="default_cash_session_list_view" model="ir.ui.view">
        <field name="name">default.cash.session.list</field>
        <field name="model">cash_session</field>
        <field name="arch" type="xml">
            <list string="Cierres de Caja"
                create="false"
                edit="false"
                delete="false"
                decoration-warning="state == 'open'"
                default_order="opened_at desc"
            >
                <field name="opened_at" string="Fecha Apertura"/>
                <field name="closed_at" string="Fecha Cierre"/>
                <field name="who_is_operating" string="Responsable"/>
                <field name="displayed_difference"
                    string="Diferencia Teorico-Final"
                    widget="monetary"
                    options="{'currency_field': 'currency_id'}"
                />
                <field name="who_closed" string="Quien validó el cierre"/>
                <field name="observations" optional="show"/>
                <field name="state"
                    string="Estado"
                    widget="badge"
                    decoration-success="state == 'closed'"
                    decoration-warning="state == 'open'"
                    width="100px"
                />
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="default_cash_session_form_view" model="ir.ui.view">
        <field name="name">default.cash.session.form.view</field>
        <field name="model">cash_session</field>
        <field name="arch" type="xml">
            <form string="Sesión Cierre de Caja/Diario">
                <header>
                    <button name="action_open_close_wizard" type="object"
                        string="Cerrar Caja"
                        class="btn-danger"
                        invisible="state != 'open'"
                        groups="werlen_repuestos_erp.group_management"
                    />
                    <button name="action_reopen_cash_session" type="object"
                        string="Reabrir Caja"
                        class="btn-warning"
                        invisible="state != 'closed'"
                        confirm="¿Estás seguro de que deseas reabrir esta caja? Se perderán los saldos confirmados."
                        groups="werlen_repuestos_erp.group_management"
                    />
                    <button name="refresh_data" type="object"
                        string="Actualizar Datos"
                        invisible="state != 'open'"
                    />
                    <button name="action_open_today_payment_lines" type="object"
                        string="Movimientos de Hoy"
                        icon="fa-list"
                        invisible="state != 'open'"
                    />
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Caja Abierta" bg_color="bg-success" invisible="state != 'open'"/>
                    <widget name="web_ribbon" title="Caja Cerrada" bg_color="bg-secondary" invisible="state != 'closed'"/>
                    <h1>
                        <field name="name" readonly="1"/>
                    </h1>
                    <group string="Información de la Caja">
                        <group>
                            <field name="journal_id" readonly="1"/>
                            <field name="previous_session" readonly="1"/>
                            <field name="who_is_operating" readonly="1"/>
                            <field name="who_closed" readonly="1"/>
                        </group>
                        <group>
                            <field name="opened_at" readonly="1"/>
                            <field name="closed_at" readonly="1"/>
                        </group>
                    </group>

                    <separator string="Movimientos Agrupados por Categoría"/>
                    <field name="line_ids">
                        <list editable="bottom" create="0" delete="0" readonly="1"
                            decoration-danger="confirmed_counted_balance == False"
                        >
                            <button name="action_open_manual_out_payment_form" type="object"
                                string="Retirar" class="btn-primary"
                                invisible="confirmed_counted_balance == True" width="70px"/>
                            <field name="category_id" width="200px"/>
                            <field name="payment_count"/>
                            <field name="opening_balance"/>
                            <field name="movements_amount" optional="hide"/>
                            <field name="theoretical_balance"/>
                            <field name="counted_balance"/>
                            <field name="difference"/>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="confirmed_by" optional="hide"/>
                            <field name="confirmed_at" optional="hide"/>
                        </list>
                    </field>

                    <separator string="Cheques dentro de la Caja" invisible="state != 'open'"/>
                    <field name="checks" invisible="state != 'open'">
                        <list create="0" delete="0">
                            <button name="action_open_change_journal_wizard" type="object"
                                string="Retirar" class="btn-primary" width="70px"/>
                            <field name="bank" string="Banco"/>
                            <field name="check_number" string="Número"/>
                            <field name="issuer" string="Emisor"/>
                            <field name="owner_of_credit" string="Propietario del Crédito"/>
                            <field name="payment_origin_explanation" string="Razón de Pago" optional="hide"/>
                            <field name="amount"/>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="time_of_creation" optional="hide"/>
                        </list>
                    </field>

                    <separator string="Retiros de esta sesión" invisible="state != 'open'"/>
                    <field name="withdrawal_ids" invisible="state != 'open'" readonly="1">
                        <list create="0" edit="0" delete="0">
                            <button name="try_undo_last_step" type="object" string="Deshacer"
                                class="btn-outline-danger" width="70px"/>
                            <field name="name" string="Referencia"/>
                            <field name="payment_method" string="Método"/>
                            <field name="amount"/>
                            <field name="observations"/>
                            <field name="time_of_payment_confirmation" string="Fecha"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>

                    <group string="Balances Totales">
                        <group>
                            <field name="opening_balance" widget="monetary" readonly="1"/>
                            <field name="theoretical_balance" widget="monetary" readonly="1"/>
                        </group>
                        <group>
                            <field name="counted_balance" widget="monetary" readonly="1" invisible="state == 'open'"/>
                            <field name="difference" widget="monetary" readonly="1" invisible="state == 'open'"/>
                        </group>
                    </group>

                    <group string="Observaciones">
                        <field name="observations" nolabel="1"
                            placeholder="Notas, aclaraciones o comentarios sobre esta sesión de caja..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="default_cash_session_search_view" model="ir.ui.view">
        <field name="name">default.cash.session.search</field>
        <field name="model">cash_session</field>
        <field name="arch" type="xml">
            <search string="Buscar cierres de caja">
                <field name="name"/>
                <field name="journal_id"/>
                <field name="who_is_operating"/>
                <field name="who_closed"/>
                <filter string="Últimos 30 días + Abiertas"
                    name="last_30_or_open"
                    domain="['|', ('opened_at','&gt;=', (context_today() - datetime.timedelta(days=30)).strftime('%%Y-%%m-%%d 00:00:00')), ('state','=', 'open') ]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Caja/Diario" name="group_journal" context="{'group_by': 'journal_id'}"/>
                </group>
                <group expand="0" string="Agrupar por">
                    <filter string="Responsable" name="group_who_is_operating" context="{'group_by': 'who_is_operating'}"/>
                </group>
                <group expand="0" string="Agrupar por">
                    <filter string="Quien validó" name="group_who_closed" context="{'group_by': 'who_closed'}"/>
                </group>
                <group expand="0" string="Agrupar por">
                    <filter string="Fecha de Apertura" name="group_opened_at" context="{'group_by': 'opened_at'}"/>
                </group>
                <group expand="0" string="Agrupar por">
                    <filter string="Fecha de Cierre" name="group_closed_at" context="{'group_by': 'closed_at'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="payment_method_form_view" model="ir.ui.view">
        <field name="name">payment.method.form</field>
        <field name="model">payment_method</field>
        <field name="arch" type="xml">
            <form string="Método de pago">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active_currently"/>
                        <field name="is_account_payment_method"/>
                        <field name="billing_coefficient"/>
                        <field name="cash_closing_category_id"/>
                        <field name="default_journal"/>
                        <field name="allowed_journals" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="payment_method_list_view" model="ir.ui.view">
        <field name="name">payment.method.list</field>
        <field name="model">payment_method</field>
        <field name="arch" type="xml">
            <list string="Métodos de pago">
                <field name="name"/>
                <field name="active_currently"/>
                <field name="is_account_payment_method"/>
                <field name="cash_closing_category_id"/>
                <field name="default_journal"/>
                <field name="billing_coefficient"/>
            </list>
        </field>
    </record>

    <record id="cash_closing_category_list_view" model="ir.ui.view">
        <field name="name">cash.closing.category.list</field>
        <field name="model">cash_closing_category</field>
        <field name="arch" type="xml">
            <list string="Categorías de cierre">
                <field name="name"/>
                <field name="active_currently"/>
                <field name="payment_method_ids"/>
            </list>
        </field>
    </record>

    <record id="account_payment_in_aggregate_list_view" model="ir.ui.view">
        <field name="name">account.payment.in.aggregate.list</field>
        <field name="model">account_payment_in_aggregate</field>
        <field name="arch" type="xml">
            <list string="Ingresos a cuenta corriente" create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="reference"/>
                <field name="source_model" optional="hide"/>
                <field name="partner_id"/>
                <field name="payment_method"/>
                <field name="original_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="unreconciled_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="payment_status" widget="badge"/>
                <field name="who_created"/>
            </list>
        </field>
    </record>

    <record id="account_payment_in_aggregate_search_view" model="ir.ui.view">
        <field name="name">account.payment.in.aggregate.search</field>
        <field name="model">account_payment_in_aggregate</field>
        <field name="arch" type="xml">
            <search string="Buscar ingresos a cuenta corriente">
                <field name="reference"/>
                <field name="partner_id"/>
                <field name="payment_method"/>
                <field name="who_created"/>
                <filter name="pending" string="Pendientes" domain="[('payment_status', 'in', ['not_paid', 'partially_paid'])]"/>
            </search>
        </field>
    </record>
</odoo>
