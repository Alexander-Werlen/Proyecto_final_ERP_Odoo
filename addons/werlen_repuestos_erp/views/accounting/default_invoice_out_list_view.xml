<odoo>
    <record id="default_invoice_out_list_view" model="ir.ui.view">
        <field name="name">default.invoice.out.list</field>
        <field name="model">invoice_out</field>
        <field name="arch" type="xml">
            <list string="Facturas"
            create="false"
            delete="false"
            decoration-danger="is_draft"
            default_order="date desc"
            >

                <field name="date"/>

                <field name="invoice_id"
                    string="Factura"
                    class="fw-bold text-dark"
                />

                <field name="client_identifier"
                width="50px"
                />

                <field name="full_name"
                    string="Cliente"
                />

                <field name="total_cost"
                    widget="monetary"
                    class="fw-bold text-dark"
                    options="{'currency_field': 'currency_id'}"
                />

                <field name="currency_id" column_invisible="True"/>

            </list>
        </field>
    </record>

    <record id="default_invoice_out_search_view" model="ir.ui.view">
        <field name="name">default.invoice.out.search</field>
        <field name="model">invoice_out</field>
        <field name="arch" type="xml">
            <search string="Factura">

                <!-- Búsqueda rápida -->
                <field name="invoice_id"/>
                <field name="client"/>
                <field name="full_name"/>
                <field name="total_cost"/>

            </search>
        </field>
    </record>
</odoo>
