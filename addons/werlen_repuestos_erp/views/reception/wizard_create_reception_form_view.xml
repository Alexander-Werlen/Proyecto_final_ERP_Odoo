<odoo>
    <record id="wizard_create_reception_form_view" model="ir.ui.view">
        <field name="name">wizard.create.reception.form</field>
        <field name="model">wizard_create_reception</field>
        <field name="arch" type="xml">
            <form string="Registrar Ingreso de Mercadería" create="false" delete="false">
                <group>
                    <group>
                        <field name="supplier_id" context="{'default_is_supplier': True, 'default_is_company': True, 'default_company_type': 'company'}"/>
                        <field name="packages_description" placeholder="Por Ej: 3 bultos + 1 pallet"/>
                        <field name="carrier_id" context="{'default_is_carrier': True, 'default_is_company': True, 'default_company_type': 'company'}"/>
                    </group>
                    <group>
                        <field name="remito_number"/>
                        <field name="who_received_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="reception_datetime"/>
                    </group>
                </group>
                <separator string="Observaciones"/>
                <field name="observations" placeholder="Notas adicionales sobre el ingreso (opcional)" nolabel="1"/>
                <footer>
                    <button name="action_create_reception" type="object" string="Crear Ingreso" class="btn-primary" confirm="¿Está seguro de que desea registrar este ingreso?"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
