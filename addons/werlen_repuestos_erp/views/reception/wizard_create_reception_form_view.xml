<odoo>
    <record id="wizard_create_reception_form_view" model="ir.ui.view">
        <field name="name">wizard.create.reception.form</field>
        <field name="model">wizard_create_reception</field>
        <field name="arch" type="xml">
            <form string="Registrar ingreso de mercadería" create="false" delete="false">
                <group>
                    <group>
                        <field name="supplier_id" context="{'default_is_supplier': True}"/>
                        <field name="packages_description" placeholder="Ej.: 3 bultos + 1 pallet"/>
                        <field name="carrier_id" context="{'default_is_carrier': True}"/>
                    </group>
                    <group>
                        <field name="remito_number"/>
                        <field name="who_received_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="reception_datetime"/>
                    </group>
                </group>
                <separator string="Observaciones"/>
                <field name="observations" nolabel="1"/>
                <footer>
                    <button name="action_create_reception" type="object"
                        string="Crear ingreso" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
