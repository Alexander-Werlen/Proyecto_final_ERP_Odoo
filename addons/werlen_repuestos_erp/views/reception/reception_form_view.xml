<odoo>
    <record id="reception_form_view" model="ir.ui.view">
        <field name="name">reception.form</field>
        <field name="model">reception</field>
        <field name="arch" type="xml">
            <form string="Ingreso de mercadería" create="false" delete="false">
                <header>
                    <field name="state" widget="statusbar"
                        statusbar_visible="pending_review,in_review,reviewed"/>
                    <button name="action_start_review" type="object"
                        string="Iniciar revisión" class="oe_highlight"
                        invisible="state != 'pending_review'"
                        groups="werlen_repuestos_erp.group_reception_control,werlen_repuestos_erp.group_administration"/>
                    <button name="action_finish_review" type="object"
                        string="Finalizar revisión" class="oe_highlight"
                        invisible="state != 'in_review'"
                        groups="werlen_repuestos_erp.group_reception_control,werlen_repuestos_erp.group_administration"/>
                    <button name="action_cancel_review" type="object"
                        string="Cancelar revisión" class="btn btn-outline-danger"
                        invisible="state != 'in_review'"
                        groups="werlen_repuestos_erp.group_reception_control,werlen_repuestos_erp.group_administration"/>
                    <button name="action_reopen_review" type="object"
                        string="Reabrir revisión" class="btn btn-outline-danger"
                        invisible="state != 'reviewed'"
                        groups="werlen_repuestos_erp.group_reception_control,werlen_repuestos_erp.group_administration"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Pendiente"
                        bg_color="bg-danger" invisible="state != 'pending_review'"/>
                    <widget name="web_ribbon" title="En revisión"
                        bg_color="bg-info" invisible="state != 'in_review'"/>
                    <widget name="web_ribbon" title="Revisado"
                        bg_color="bg-success" invisible="state != 'reviewed'"/>
                    <h1>INGRESO DE MERCADERÍA
                        <field name="name" class="ms-2 text-muted fw-normal" readonly="1" nolabel="1"/>
                    </h1>
                    <group string="Datos del ingreso">
                        <group>
                            <field name="supplier_id" readonly="1"
                                options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="packages_description"/>
                            <field name="carrier_id" readonly="1"
                                options="{'no_create': True, 'no_create_edit': True}"/>
                        </group>
                        <group>
                            <field name="remito_number"/>
                            <field name="who_received_ids" widget="many2many_tags" readonly="1"
                                options="{'no_create': True, 'no_open': True}"/>
                            <field name="reception_datetime" readonly="1"/>
                        </group>
                    </group>
                    <separator string="Facturas de compra"/>
                    <field name="purchase_invoice_ids" widget="many2many_tags" readonly="1"/>
                    <separator string="Observaciones"/>
                    <field name="observations" nolabel="1"/>
                    <group string="Control" invisible="state == 'pending_review'">
                        <field name="controlled_datetime_start" readonly="1"/>
                        <field name="controlled_datetime_end" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
