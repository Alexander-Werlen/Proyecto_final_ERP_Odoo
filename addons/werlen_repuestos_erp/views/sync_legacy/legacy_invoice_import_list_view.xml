<odoo>
    <data>
        <record id="legacy_invoice_import_list_view" model="ir.ui.view">
            <field name="name"></field>
            <field name="model">legacy_invoice_import</field>
            <field name="arch" type="xml">
                <list create="0" edit="0" delete="0">
                    <field name="state"
                           string="Estado"
                           widget="badge"
                           decoration-success="state == 'done'"
                           decoration-warning="state not in ['done', 'failed']"
                           decoration-danger="state == 'failed'"/>
                    <field name="filename"/>
                    <field name="attempts"/>
                    <field name="last_error"/>
                    <field name="last_attempt_at"/>
                    <field name="correlation_id" optional="hide"/>
                </list>
            </field>
        </record>
    </data>
</odoo>
