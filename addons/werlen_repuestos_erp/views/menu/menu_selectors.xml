<odoo>
<data>
    <!-- Actions -->
    <record id="action_invoice_out_create_wizard" model="ir.actions.act_window">
        <field name="name">Create New</field>
        <field name="res_model">invoice_out_create_wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_open_invoices_out" model="ir.actions.act_window">
        <field name="name">Outgoing Invoices</field>
        <field name="res_model">invoice_out</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('werlen_repuestos_erp.default_invoice_out_list_view')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('werlen_repuestos_erp.invoice_out_form_view')})
        ]"/>
        <field name="search_view_id" ref="werlen_repuestos_erp.default_invoice_out_search_view"/>
    </record>

    <record id="action_open_legacy_invoice_imports" model="ir.actions.act_window">
        <field name="name">Invoice Synchronization</field>
        <field name="res_model">legacy_invoice_import</field>
        <field name="view_mode">list</field>
    </record>

    <record id="action_seller_dashboard" model="ir.actions.client">
        <field name="name">Sales Dashboard</field>
        <field name="tag">werlen_repuestos_erp.seller_dashboard</field>
    </record>

    <record id="action_preparation_dashboard" model="ir.actions.client">
        <field name="name">Preparation Dashboard</field>
        <field name="tag">werlen_repuestos_erp.preparation_team_dashboard</field>
    </record>

    <record id="action_open_seller_sale_fulfillment_order" model="ir.actions.act_window">
        <field name="name">Sales</field>
        <field name="res_model">sale_fulfillment_order</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="werlen_repuestos_erp.seller_sale_fulfillment_order_list_view"/>
        <field name="search_view_id" ref="werlen_repuestos_erp.seller_sale_fulfillment_order_search_view"/>
    </record>

    <record id="action_open_relevant_seller_sale_fulfillment_order" model="ir.actions.act_window">
        <field name="name">Sales (Relevant)</field>
        <field name="res_model">sale_fulfillment_order</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="werlen_repuestos_erp.seller_sale_fulfillment_order_list_view"/>
        <field name="search_view_id" ref="werlen_repuestos_erp.seller_sale_fulfillment_order_search_view"/>
        <field name="domain">[
            ('seller_user_id', '=', uid),
            ('logistical_status', 'not in', ['sent', 'avoid_tracking'])
        ]</field>
    </record>

    <record id="action_open_issued_by_self_seller_sale_fulfillment_order" model="ir.actions.act_window">
        <field name="name">My Sales</field>
        <field name="res_model">sale_fulfillment_order</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="werlen_repuestos_erp.seller_sale_fulfillment_order_list_view"/>
        <field name="search_view_id" ref="werlen_repuestos_erp.seller_sale_fulfillment_order_search_view"/>
        <field name="domain">[
            ('seller_user_id', '=', uid)
        ]</field>
    </record>

    <record id="action_open_accountant_sale_fulfillment_order_list_view" model="ir.actions.act_window">
        <field name="name">Cashier</field>
        <field name="res_model">sale_fulfillment_order</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="werlen_repuestos_erp.accountant_sale_fulfillment_order_list_view"/>
        <field name="search_view_id" ref="werlen_repuestos_erp.accountant_sale_fulfillment_order_search_view"/>
    </record>

    <record id="action_open_relevant_accountant_sale_fulfillment_order_list_view" model="ir.actions.act_window">
        <field name="name">Invoices (Relevant)</field>
        <field name="res_model">sale_fulfillment_order</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="werlen_repuestos_erp.accountant_sale_fulfillment_order_list_view"/>
        <field name="search_view_id" ref="werlen_repuestos_erp.accountant_sale_fulfillment_order_search_view"/>
        <field name="domain">
            [('logistical_status', 'in', ['draft', 'awaiting_preparation', 'in_preparation', 'prepared'])]
        </field>
    </record>

    <record id="action_open_hand_out_sale_fulfillment_order_list_view" model="ir.actions.act_window">
        <field name="name">Hand Out</field>
        <field name="res_model">sale_fulfillment_order</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="werlen_repuestos_erp.hand_out_sale_fulfillment_order_list_view"/>
        <field name="search_view_id" ref="werlen_repuestos_erp.hand_out_sale_fulfillment_order_search_view"/>
    </record>

    <record id="action_open_relevant_hand_out_sale_fulfillment_order_list_view" model="ir.actions.act_window">
        <field name="name">Hand Out (Relevant)</field>
        <field name="res_model">sale_fulfillment_order</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="werlen_repuestos_erp.hand_out_sale_fulfillment_order_list_view"/>
        <field name="search_view_id" ref="werlen_repuestos_erp.hand_out_sale_fulfillment_order_search_view"/>
        <field name="domain">
            [('logistical_status', 'in', ['prepared', 'awaiting_preparation', 'in_preparation'])]
        </field>
    </record>

    <record id="action_open_preparation_sale_fulfillment_order_list_view" model="ir.actions.act_window">
        <field name="name">Preparation (All)</field>
        <field name="res_model">sale_fulfillment_order</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="werlen_repuestos_erp.preparation_sale_fulfillment_order_list_view"/>
        <field name="search_view_id" ref="werlen_repuestos_erp.preparation_sale_fulfillment_order_search_view"/>
        <field name="domain">[('is_asigned_to_preparation_team', '=', True)]</field>
        <field name="context">
            {
                'group_by': 'who_withdraws',
                'group_by_no_leaf': 1
            }
        </field>
    </record>

    <record id="action_open_relevant_preparation_sale_fulfillment_order_list_view" model="ir.actions.act_window">
        <field name="name">Preparation (Relevant)</field>
        <field name="res_model">sale_fulfillment_order</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="werlen_repuestos_erp.preparation_sale_fulfillment_order_list_view"/>
        <field name="search_view_id" ref="werlen_repuestos_erp.preparation_sale_fulfillment_order_search_view"/>
        <field name="domain">
            [
                ('is_asigned_to_preparation_team', '=', True),
                ('logistical_status', 'in', ['awaiting_preparation', 'in_preparation', 'prepared'])
            ]
        </field>
        <field name="context">
            {
                'group_by': 'who_withdraws',
                'group_by_no_leaf': 1
            }
        </field>
    </record>

    <!-- Root Menus -->
    <menuitem id="menu_accounting" name="Accounting" sequence="2"
    groups="werlen_repuestos_erp.group_accountant,werlen_repuestos_erp.group_administration,werlen_repuestos_erp.group_management,werlen_repuestos_erp.group_system"
    />

    <menuitem id="menu_accounting_settings" name="Settings" parent="menu_accounting" sequence="99"
    groups="werlen_repuestos_erp.group_administration,werlen_repuestos_erp.group_system"/>
    <menuitem id="menu_accounting_settings_legacy_invoice_import" name="Synchronization"
        parent="menu_accounting_settings" action="action_open_legacy_invoice_imports" sequence="1"/>

    <menuitem id="menu_fulfillment" name="Operations" sequence="1"/>

    <!-- Accounting Menu -->
    <menuitem id="menu_accounting_invoice_out" name="Outgoing Invoices" parent="menu_accounting" sequence="1"/>
    <menuitem id="menu_accounting_invoice_out_all" name="View All" parent="menu_accounting_invoice_out" action="action_open_invoices_out" sequence="1"/>
    <menuitem id="menu_accounting_invoice_out_create_new" name="Create New" parent="menu_accounting_invoice_out" action="action_invoice_out_create_wizard" sequence="2"/>

    <!-- Operations Menu -->
    <menuitem id="menu_fulfillment_sales" name="Sales" parent="menu_fulfillment" sequence="1"
    groups="werlen_repuestos_erp.group_sales,werlen_repuestos_erp.group_administration,werlen_repuestos_erp.group_management"
    />
    <menuitem
        id="menu_seller_dashboard"
        name="Dashboard"
        action="werlen_repuestos_erp.action_seller_dashboard"
        parent="menu_fulfillment_sales"
        sequence="1"
    />
    <menuitem id="menu_fulfillment_sales_relevant" name="Relevant" parent="menu_fulfillment_sales" action="action_open_relevant_seller_sale_fulfillment_order" sequence="2"/>
    <menuitem id="menu_fulfillment_sales_issued_by_self" name="My Sales" parent="menu_fulfillment_sales" action="action_open_issued_by_self_seller_sale_fulfillment_order" sequence="3"/>
    <menuitem id="menu_fulfillment_sales_all" name="All" parent="menu_fulfillment_sales" action="action_open_seller_sale_fulfillment_order" sequence="4"
    groups="werlen_repuestos_erp.group_administration,werlen_repuestos_erp.group_management"
    />

    <menuitem id="menu_fulfillment_accountant" name="Cashier" parent="menu_fulfillment" sequence="2"
    groups="werlen_repuestos_erp.group_accountant,werlen_repuestos_erp.group_administration,werlen_repuestos_erp.group_management"
    />
    <menuitem id="menu_fulfillment_accountant_invoices" name="Invoices" parent="menu_fulfillment_accountant" sequence="1"/>
    <menuitem id="menu_fulfillment_accountant_invoices_relevant" name="Relevant" parent="menu_fulfillment_accountant_invoices" action="action_open_relevant_accountant_sale_fulfillment_order_list_view" sequence="1"/>
    <menuitem id="menu_fulfillment_accountant_invoices_all" name="All" parent="menu_fulfillment_accountant_invoices" action="action_open_accountant_sale_fulfillment_order_list_view" sequence="2"/>

    <menuitem id="menu_fulfillment_preparation" name="Preparation" parent="menu_fulfillment" sequence="3"
    groups="werlen_repuestos_erp.group_preparation,werlen_repuestos_erp.group_administration,werlen_repuestos_erp.group_management"
    />
    <menuitem
        id="menu_preparation_dashboard"
        name="Dashboard"
        action="werlen_repuestos_erp.action_preparation_dashboard"
        parent="menu_fulfillment_preparation"
        sequence="1"
    />
    <menuitem id="menu_fulfillment_preparation_relevant" name="Relevant" parent="menu_fulfillment_preparation" action="action_open_relevant_preparation_sale_fulfillment_order_list_view" sequence="2"/>
    <menuitem id="menu_fulfillment_preparation_all" name="All" parent="menu_fulfillment_preparation" action="action_open_preparation_sale_fulfillment_order_list_view" sequence="3"/>

    <menuitem id="menu_fulfillment_hand_out" name="Hand Out" parent="menu_fulfillment" sequence="4"
    groups="werlen_repuestos_erp.group_preparation,werlen_repuestos_erp.group_accountant,werlen_repuestos_erp.group_administration,werlen_repuestos_erp.group_management"
    />
    <menuitem id="menu_fulfillment_hand_out_relevant" name="Relevant" parent="menu_fulfillment_hand_out" action="action_open_relevant_hand_out_sale_fulfillment_order_list_view" sequence="1"/>
    <menuitem id="menu_fulfillment_hand_out_all" name="All" parent="menu_fulfillment_hand_out" action="action_open_hand_out_sale_fulfillment_order_list_view" sequence="2"/>

</data>
</odoo>
