<odoo>
    <data>

        <!-- ========================================================= -->
        <!-- PASO 1: Identificación + Pagos -->
        <!-- ========================================================= -->
        <record id="wizard_fulfillment_order_verification_step_1" model="ir.ui.view">
            <field name="name">wizard.fulfillment.verification.step.1</field>
            <field name="model">wizard_fulfillment_order_verification</field>
            <field name="arch" type="xml">
                <form>
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label for="invoice_id"/>
                            <field name="invoice_id" readonly="1" class="w-100"/>
                            <label for="full_name"/>
                            <field name="full_name" readonly="1" class="w-100"/>
                        </div>
                        <div class="col-md-6">
                            <field name="currency_id" invisible="1"/>
                            <label for="total_cost"/>
                            <field name="total_cost" readonly="1" class="w-100"/>
                            <label for="is_account_move"/>
                            <field name="is_account_move" widget="boolean_toggle" string="Cuenta Corriente" class="w-100"/>
                        </div>
                    </div>

                    <div class="row g-4" invisible="is_account_move">
                        <div class="col-md-7">
                            <h3>Lista de Pagos</h3>
                            <field name="payments" nolabel="1">
                                <list editable="bottom">
                                    <field name="payment_method" domain="[('active_currently', '=', True)]" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="journal" domain="[('allowed_payment_methods', 'in', payment_method)]" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="amount"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </div>
                        <div class="col-md-5">
                            <h3>Resumen</h3>
                            <label for="wizard_amount_remaining"/>
                            <field name="wizard_amount_remaining" readonly="1" class="fw-bold text-danger w-100"/>
                            <label for="total_cost"/>
                            <field name="total_cost" readonly="1" string="Importe Factura" class="w-100"/>
                            <field name="currency_id" invisible="1"/>
                            <label for="wizard_payment_total"/>
                            <field name="wizard_payment_total" readonly="1" string="Total Pagos" class="w-100"/>
                        </div>
                    </div>

                    <footer>
                        <button string="Siguiente"
                            type="object"
                            name="action_next_step"
                            class="oe_highlight"
                            data-hotkey="enter"
                        />
                        <button string="Cancelar"
                            special="cancel"
                            data-hotkey="c"
                        />
                        <button string="Saltar Verificación"
                            type="object"
                            name="action_skip_verification"
                            groups="werlen_repuestos_erp.group_management,werlen_repuestos_erp.group_administration"
                            class="btn-outline-danger"
                            confirm="¿Está seguro de que desea saltar la verificación?"
                        />
                    </footer>
                </form>

            </field>
        </record>

        <!-- ========================================================= -->
        <!-- PASO 2: Envío / Flete -->
        <!-- ========================================================= -->
        <record id="wizard_fulfillment_order_verification_step_2" model="ir.ui.view">
            <field name="name">wizard.fulfillment.verification.step.2</field>
            <field name="model">wizard_fulfillment_order_verification</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <label for="has_delivery"/>
                                <field name="has_delivery" widget="boolean_toggle" class="w-100"/>
                            </div>
                            <div class="col-md-6">
                                <label for="allow_repayment"/>
                                <field name="allow_repayment" invisible="not has_delivery" widget="boolean_toggle" class="w-100"/>
                            </div>
                        </div>

                        <separator string="Datos del Envio" invisible="not has_delivery"/>
                        <div class="row g-4" invisible="not has_delivery">
                            <div class="col-md-6">
                                <label for="who_withdraws"/>
                                <field name="who_withdraws" class="w-100"/>
                                <label for="destination"/>
                                <field name="destination" class="w-100"/>
                            </div>
                            <div class="col-md-6">
                                <label for="city"/>
                                <field name="city" class="w-100"/>
                                <label for="state"/>
                                <field name="state" class="w-100"/>
                            </div>
                        </div>

                    </sheet>

                    <footer>
                        <button string="Siguiente"
                                type="object"
                                name="action_next_step"
                                data-hotkey="enter"
                                class="oe_highlight"/>
                        <button string="Atrás"
                                type="object"
                                data-hotkey="c"
                                name="action_previous_step"/>
                        <button string="Cancelar"
                                special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- ========================================================= -->
        <!-- PASO 3: Datos operativos -->
        <!-- ========================================================= -->
        <record id="wizard_fulfillment_order_verification_step_3" model="ir.ui.view">
            <field name="name">wizard.fulfillment.verification.step.3</field>
            <field name="model">wizard_fulfillment_order_verification</field>
            <field name="arch" type="xml">
                <form>
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label for="is_asigned_to_preparation_team"/>
                            <field name="is_asigned_to_preparation_team" widget="boolean_toggle" class="w-100"/>
                        </div>
                        <div class="col-md-6">
                            <label for="allow_deferred_payment"/>
                            <field name="allow_deferred_payment" widget="boolean_toggle" class="w-100"/>
                        </div>
                    </div>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label for="point_of_sale"/>
                            <field name="point_of_sale" required="1"
                                options="{'no_create': True, 'no_create_edit': True}" class="w-100"/>
                        </div>
                        <div class="col-md-6">
                            <label for="cellphone"/>
                            <field name="cellphone" placeholder="Ej: 342-4751510" class="w-100"/>
                        </div>
                    </div>

                    <footer>
                        <button string="Siguiente"
                                type="object"
                                name="action_next_step"
                                data-hotkey="enter"
                                class="oe_highlight"/>
                        <button string="Atrás"
                                type="object"
                                data-hotkey="c"
                                name="action_previous_step"/>
                        <button string="Cancelar"
                                special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- ========================================================= -->
        <!-- PASO 4: Confirmación final -->
        <!-- ========================================================= -->
        <record id="wizard_fulfillment_order_verification_step_4" model="ir.ui.view">
            <field name="name">wizard.fulfillment.verification.step.4</field>
            <field name="model">wizard_fulfillment_order_verification</field>
            <field name="arch" type="xml">
                <form string="Confirmar Verificación" class="o_form_narrow">

                    <field name="currency_id" invisible="1"/>
                    <div class="alert alert-info" role="alert">
                        <strong>Revisión final:</strong> verificá los datos antes de confirmar.
                        Si encontrás un error, podés volver atrás y corregirlo.
                    </div>
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label for="invoice_id"/>
                            <field name="invoice_id" readonly="1" class="w-100"/>
                            <label for="seller"/>
                            <field name="seller" readonly="1" class="w-100"/>
                        </div>
                        <div class="col-md-6">
                            <label for="client"/>
                            <field name="client" readonly="1" class="w-100"/>
                            <label for="full_name"/>
                            <field name="full_name" readonly="1" class="w-100"/>
                        </div>
                    </div>

                    <!-- ===================== -->
                    <!-- PAGOS -->
                    <!-- ===================== -->
                    <separator string="Pagos"/>
                    <div class="row g-4" invisible="not is_account_move">
                        <div class="col-md-6">
                            <label for="is_account_move"/>
                            <field name="is_account_move" widget="boolean_toggle" readonly="1" string="Cuenta Corriente" class="w-100"/>
                        </div>
                    </div>
                    <div class="row g-4" invisible="is_account_move">
                        <div class="col-md-7">
                            <h4>Lista de Pagos</h4>
                            <field name="payments" nolabel="1" readonly="1">
                                <list disable_open="1" create="0">
                                    <field name="payment_method"/>
                                    <field name="journal"/>
                                    <field name="amount"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </div>
                        <div class="col-md-5">
                            <h4>Resumen</h4>
                            <label for="total_cost"/>
                            <field name="total_cost" readonly="1" class="w-100"/>
                            <label for="wizard_payment_total"/>
                            <field name="wizard_payment_total" readonly="1" class="w-100"/>
                            <label for="wizard_amount_remaining"/>
                            <field name="wizard_amount_remaining" readonly="1" class="w-100"/>
                        </div>
                    </div>

                    <!-- ===================== -->
                    <!-- CONFIGURACIÓN OPERATIVA -->
                    <!-- ===================== -->
                    <separator string="Datos Operativos"/>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label for="is_asigned_to_preparation_team"/>
                            <field name="is_asigned_to_preparation_team" readonly="1" widget="boolean_toggle" class="w-100"/>
                            <label for="allow_deferred_payment"/>
                            <field name="allow_deferred_payment" readonly="1" widget="boolean_toggle" class="w-100"/>
                        </div>
                        <div class="col-md-6">
                            <label for="point_of_sale"/>
                            <field name="point_of_sale" readonly="1" class="w-100"/>
                            <label for="cellphone"/>
                            <field name="cellphone" readonly="1" class="w-100"/>
                        </div>
                    </div>

                    <!-- ===================== -->
                    <!-- ENVÍO / RETIRO -->
                    <!-- ===================== -->
                    <separator string="Envío / Retiro"/>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label for="has_delivery"/>
                            <field name="has_delivery" readonly="1" widget="boolean_toggle" class="w-100"/>
                            <label for="allow_repayment"/>
                            <field name="allow_repayment" readonly="1" widget="boolean_toggle" class="w-100"/>
                        </div>
                    </div>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label for="who_withdraws"/>
                            <field name="who_withdraws" readonly="1" class="w-100"/>
                            <label for="destination"/>
                            <field name="destination" readonly="1" class="w-100"/>
                        </div>
                        <div class="col-md-6">
                            <label for="city"/>
                            <field name="city" readonly="1" class="w-100"/>
                            <label for="state"/>
                            <field name="state" readonly="1" class="w-100"/>
                        </div>
                    </div>

                    <!-- ===================== -->
                    <!-- FOOTER -->
                    <!-- ===================== -->
                    <footer>
                        <button string="Confirmar"
                                type="object"
                                name="action_confirm"
                                data-hotkey="enter"
                                class="oe_highlight"/>

                        <button string="Atrás"
                                type="object"
                                data-hotkey="c"
                                name="action_previous_step"/>

                        <button string="Cancelar"
                                special="cancel"/>
                    </footer>

                </form>
            </field>
        </record>

    </data>
</odoo>
