<odoo>
    <data>
        <record id="wizard_client_claim_supplier_claim_decision_form_view" model="ir.ui.view">
            <field name="name">wizard.client.claim.supplier.claim.decision.form</field>
            <field name="model">wizard.client.claim.supplier.claim</field>
            <field name="arch" type="xml">
                <form string="¿Se quiere reclamar al proveedor la garantía?" create="false" delete="false">
                    <footer>
                        <button name="action_create_supplier_claim"
                            type="object"
                            string="Reclamar a proveedor"
                            class="oe_highlight"
                        />
                        <button name="action_mark_supplier_claim_not_required"
                            type="object"
                            string="Nunca será reclamado"
                            class="btn-secondary"
                        />
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
