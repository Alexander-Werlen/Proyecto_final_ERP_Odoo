<odoo><record id="wizard_create_client_claim_form_view" model="ir.ui.view">
    <field name="name">wizard.create.client.claim.form</field><field name="model">wizard_create_client_claim</field>
    <field name="arch" type="xml"><form string="Crear reclamo de cliente">
        <group><field name="claim_date"/><field name="client_name"/><field name="client_address"/><field name="client_phone"/>
            <field name="product_id"/><field name="product_brand"/><field name="vehicle_description"/>
            <field name="sale_fulfillment_order_id"/><field name="reason"/></group>
        <footer><button name="action_create_client_claim" type="object" string="Crear" class="oe_highlight"/><button string="Cancelar" special="cancel"/></footer>
    </form></field>
</record></odoo>
