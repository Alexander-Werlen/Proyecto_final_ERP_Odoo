<odoo>
    <data>
        <record id="wizard_create_client_claim_form_view" model="ir.ui.view">
            <field name="name">wizard.create.client.claim.form</field>
            <field name="model">wizard_create_client_claim</field>
            <field name="arch" type="xml">
                <form string="Crear Reclamo de Cliente" create="false" delete="false">
                    <sheet>
                        <group>
                            <group string="Datos del reclamo">
                                <field name="product_brand"/>
                                <field name="product_id"/>
                                <field name="sale_fulfillment_order_id" options="{'no_create': True}"/>
                                <field name="reason" placeholder="Describa el motivo del reclamo"/>
                            </group>
                            <group string="Datos del cliente">
                                <field name="client_name"/>
                                <field name="client_phone"/>
                                <field name="client_address"/>
                                <field name="vehicle_description"/>
                                <field name="claim_date"/>
                            </group>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_create_client_claim" type="object" string="Crear reclamo"
                            class="oe_highlight" data-hotkey="enter"/>
                        <button string="Cancelar" special="cancel" data-hotkey="c"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
