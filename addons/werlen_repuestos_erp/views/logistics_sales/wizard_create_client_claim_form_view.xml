<odoo>
    <data>
        <record id="wizard_create_client_claim_form_view" model="ir.ui.view">
            <field name="name">wizard.create.client.claim.form</field>
            <field name="model">wizard_create_client_claim</field>
            <field name="arch" type="xml">
                <form string="Crear Reclamo de Cliente" create="false" delete="false">
                    <group>
                        <group>
                            <field name="product_brand"/>
                            <field name="product_id"/>
                            <field name="sale_fulfillment_order_id" options="{'no_create': True}" readonly="1" groups="werlen_repuestos_erp.group_galvez"/>
                            <field name="sale_fulfillment_order_id" options="{'no_create': True}" groups="!werlen_repuestos_erp.group_galvez"/>
                            <field name="reason" placeholder="Describa el motivo del reclamo"/>
                        </group>
                        <group>
                            <field name="client_name"/>
                            <field name="client_phone"/>
                            <field name="client_address"/>
                            <field name="vehicle_description"/>
                            <field name="claim_date"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_create_client_claim" type="object" string="Crear Reclamo" class="btn-primary" invisible="sale_fulfillment_order_id" confirm="No se especificó una factura de venta. ¿Desea crear el reclamo de todos modos?"/>
                        <button name="action_create_client_claim" type="object" string="Crear Reclamo" class="btn-primary" invisible="not sale_fulfillment_order_id"/>
                        <button string="Cancelar" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
