<odoo>
    <data>
        <record id="hand_out_sale_fulfillment_order_list_view" model="ir.ui.view">
            <field name="name">Hand Out Fulfillment Order List View</field>
            <field name="model">sale_fulfillment_order</field>
            <field name="arch" type="xml">
                <list create="0" delete="0" edit="0" default_order="date desc">

                    <header>
                        <button name="hand_out"
                        type="object"
                        string="Entregar"
                        class="btn-primary"
                        />
                        <button name="undo_hand_out"
                        type="object"
                        string="Deshacer Entrega"
                        class="btn-outline-danger"
                        />
                    </header>

                    <field name="logistical_status"
                    widget="badge"
                    decoration-danger="logistical_status == 'awaiting_preparation'"
                    decoration-warning="logistical_status == 'in_preparation'"
                    decoration-success="logistical_status == 'prepared'"
                    decoration-primary="logistical_status in ['sent', 'avoid_tracking']"
                    width="120px"
                    string="Estado"
                    />
                    <field name="date" optional="hide"/>
                    <field name="invoice_id"/>
                    <field name="client_identifier"
                    string="Num Cliente"
                    width="50px"
                    />
                    <field name="full_name"
                    string="Nombre del Cliente"
                    class="fw-bold text-dark"
                    />
                    <field name="seller" optional="hide"/>
                    <field name="who_withdraws"/>
                    <field name="who_prepared"
                    optional="hide"
                    />
                    <field name="allow_repayment"
                    widget="boolean_toggle"
                    string="Contra-reembolso"
                    width="70px"
                    />
                    <field name="is_account_move"
                    widget="boolean_toggle"
                    string="Cuenta corriente"
                    width="70px"
                    optional="hide"
                    />
                    <field name="packages_count"
                    class="fw-bold text-dark"
                    />
                    <field name="total_cost"
                    class="fw-bold text-dark"
                    />
                    <field name="currency_id" column_invisible="True"/>
                    <field name="payment_status"
                    widget="badge"
                    decoration-success="payment_status == 'paid'"
                    decoration-warning="payment_status == 'partially_paid'"
                    decoration-danger="payment_status == 'not_paid'"
                    decoration-info="payment_status == 'account'"
                    width="100px"
                    string="Pago"
                    />
                </list>
            </field>
        </record>

        <record id="hand_out_sale_fulfillment_order_search_view" model="ir.ui.view">
            <field name="name">hand.out.sale.fulfillment.order.search</field>
            <field name="model">sale_fulfillment_order</field>
            <field name="arch" type="xml">
                <search string="Orden de venta">

                    <!-- Búsqueda rápida -->
                    <field name="invoice_id"/>
                    <field name="client"/>
                    <field name="full_name"/>
                    <field name="seller"/>
                    <field name="who_withdraws"/>
                    <field name="total_cost" string="Importe total"/>

                    <!-- Filtros -->

                    <filter name="draft"
                            string="Borrador"
                            domain="[('logistical_status','=','draft')]"/>

                    <filter name="awaiting_preparation"
                            string="A Preparar"
                            domain="[('logistical_status','=','awaiting_preparation')]"/>

                    <filter name="in_preparation"
                            string="En preparación"
                            domain="[('logistical_status','=','in_preparation')]"/>

                    <filter name="prepared"
                            string="Preparado"
                            domain="[('logistical_status','=','prepared')]"/>

                    <filter name="sent"
                            string="Entregado"
                            domain="[('logistical_status','=','sent')]"/>

                    <filter name="avoid_tracking"
                            string="Sin Seguimiento"
                            domain="[('logistical_status','=','avoid_tracking')]"/>

                    <!-- Agrupaciones -->
                    <group expand="0" string="Agrupar por">
                        <filter string="Quién Retira"
                        name="group_who_withdraws"
                        context="{'group_by':'who_withdraws'}"/>
                    </group>

                    <group expand="0" string="Agrupar por">
                        <filter string="Estado Logistico"
                        name="group_logistical_status"
                        context="{'group_by':'logistical_status'}"/>
                    </group>

                </search>
            </field>
        </record>
    </data>
</odoo>
