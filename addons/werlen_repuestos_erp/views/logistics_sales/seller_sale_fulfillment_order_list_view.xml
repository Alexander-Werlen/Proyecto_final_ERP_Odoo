<odoo>
    <data>
        <record id="seller_sale_fulfillment_order_list_view" model="ir.ui.view">
            <field name="name">Seller Fulfillment Order List View</field>
            <field name="model">sale_fulfillment_order</field>
            <field name="arch" type="xml">
                <list create="0" delete="0" edit="0" string="Ventas" default_order="date desc">
                    <field name="logistical_status"
                    widget="badge"
                    decoration-danger="logistical_status == 'draft'"
                    decoration-warning="logistical_status == 'awaiting_payment'"
                    decoration-primary="logistical_status in ['prepared', 'awaiting_preparation', 'in_preparation']"
                    decoration-success="logistical_status in ['avoid_tracking', 'sent']"
                    width="120px"
                    string="Estado"
                    />
                    <field name="date"/>
                    <field name="invoice_id"/>
                    <field name="client_identifier"
                    width="50px"
                    />
                    <field name="full_name" string="Nombre del Cliente" class="fw-bold text-dark"/>
                    <field name="seller" optional="hide"/>
                    <field name="who_withdraws" optional="hide"/>
                    <field name="destination" optional="hide"/>
                    <field name="city" optional="hide"/>
                    <field name="is_asigned_to_preparation_team"
                    widget="boolean_toggle"
                    width="60px"
                    />
                    <field name="allow_repayment"
                    widget="boolean_toggle"
                    string="Contra-Reembolso"
                    width="70px"
                    />
                    <field name="is_account_move"
                    widget="boolean_toggle"
                    string="Cuenta-Corriente"
                    width="70px"
                    optional="hide"
                    />
                    <field name="total_cost" class="fw-bold text-dark"/>
                    <field name="currency_id" column_invisible="True"/>
                    <field name="payment_status"
                    widget="badge"
                    decoration-danger="payment_status == 'not_paid'"
                    decoration-warning="payment_status == 'partially_paid'"
                    decoration-success="payment_status == 'paid'"
                    decoration-info="payment_status == 'account'"
                    width="100px"
                    string="Pago"
                    />
                </list>
            </field>
        </record>

        <record id="seller_sale_fulfillment_order_search_view" model="ir.ui.view">
            <field name="name">seller.sale.fulfillment.order.search</field>
            <field name="model">sale_fulfillment_order</field>
            <field name="arch" type="xml">
                <search string="Orden de venta">

                    <!-- Búsqueda rápida -->
                    <field name="invoice_id"/>
                    <field name="client"/>
                    <field name="full_name"/>
                    <field name="seller"/>
                    <field name="who_withdraws"/>
                    <field name="destination"/>
                    <field name="city"/>

                    <!-- Filtros -->

                    <filter name="draft"
                            string="Borrador"
                            domain="[('logistical_status','=','draft')]"/>

                    <filter name="awaiting_payment"
                            string="A Pagar"
                            domain="[('logistical_status','=','awaiting_payment')]"/>

                    <filter name="awaiting_preparation"
                            string="A Preparar"
                            domain="[('logistical_status','=','awaiting_preparation')]"/>

                    <filter name="in_preparation"
                            string="En preparación"
                            domain="[('logistical_status','=','in_preparation')]"/>

                    <filter name="prepared"
                            string="Preparado"
                            domain="[('logistical_status','=','prepared')]"/>

                    <filter name="sent"
                            string="Entregado"
                            domain="[('logistical_status','in', ['sent', 'avoid_tracking'])]"/>

                    <filter name="today_sent"
                        string="Entregado hoy"
                        domain="[
                            ('logistical_status','in', ['sent', 'avoid_tracking']),
                            ('time_of_handing_over','!=',False),
                            ('time_of_handing_over','&gt;=', context_today().strftime('%%Y-%%m-%%d 00:00:00')),
                            ('time_of_handing_over','&lt;=', context_today().strftime('%%Y-%%m-%%d 23:59:59'))
                    ]"/>

                    <filter name="avoid_tracking"
                            string="Sin Seguimiento"
                            domain="[('logistical_status','=','avoid_tracking')]"/>

                    <!-- Agrupaciones -->
                    <group expand="0" string="Agrupar por">
                        <filter string="Estado del Pago"
                        name="group_payment_status"
                        context="{'group_by':'payment_status'}"/>
                    </group>

                    <group expand="0" string="Agrupar por">
                        <filter string="Estado Logistico"
                        name="group_logistical_status"
                        context="{'group_by':'logistical_status'}"/>
                    </group>

                </search>
            </field>
        </record>
    </data>
</odoo>
