<odoo>
    <record id="wizard_create_purchase_invoice_form_view" model="ir.ui.view">
        <field name="name">wizard.create.purchase.invoice.form</field>
        <field name="model">wizard_create_purchase_invoice</field>
        <field name="arch" type="xml">
            <form string="Crear factura de compra" create="false" delete="false">
                <group>
                    <field name="supplier_id" context="{'default_is_supplier': True}"/>
                    <field name="name" placeholder="Ej.: 0001-12345"/>
                </group>
                <footer>
                    <button name="action_create_purchase_invoice" type="object"
                        string="Crear" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
