<odoo>
    <record id="wizard_associate_return_line_claim_form_view" model="ir.ui.view">
        <field name="name">wizard.associate.return.line.claim.form</field>
        <field name="model">wizard_associate_return_line_claim</field>
        <field name="arch" type="xml">
            <form string="Asociar reclamo a devolución">
                <group><field name="return_note_id"/><field name="claim_id"/>
                    <field name="product_code"/><field name="product_description"/>
                    <field name="reason"/><field name="quantity"/></group>
                <footer><button name="action_associate" type="object" string="Asociar" class="oe_highlight"/>
                    <button string="Cancelar" special="cancel"/></footer>
            </form>
        </field>
    </record>
</odoo>
