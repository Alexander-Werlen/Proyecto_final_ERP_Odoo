<odoo>
    <data>
        <record id="wizard_associate_return_line_claim_form_view" model="ir.ui.view">
            <field name="name">wizard.associate.return.line.claim.form</field>
            <field name="model">wizard_associate_return_line_claim</field>
            <field name="arch" type="xml">
                <form string="Asociar reclamo a devolución" create="false" delete="false">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label for="return_note_id"/>
                            <field name="return_note_id" readonly="1" class="w-100"/>
                            <label for="claim_id"/>
                            <field name="claim_id" options="{'no_create': True, 'no_open': True}" class="w-100"/>
                        </div>
                        <div class="col-md-6">
                            <label for="product_code"/>
                            <field name="product_code" readonly="1" class="w-100"/>
                            <label for="quantity"/>
                            <field name="quantity" class="w-100"/>
                        </div>
                    </div>
                    <separator string="Datos de la devolución"/>
                    <label for="product_description"/>
                    <field name="product_description" readonly="1" class="w-100"/>
                    <label for="reason"/>
                    <field name="reason" class="w-100"/>
                    <footer>
                        <button name="action_associate" type="object" string="Asociar" class="oe_highlight"/>
                        <button string="Cancelar" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
