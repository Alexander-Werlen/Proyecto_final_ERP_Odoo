<odoo>
    <data>
        <record id="wizard_create_supplier_claim_form_view" model="ir.ui.view">
            <field name="name">wizard.create.supplier.claim.form</field>
            <field name="model">wizard_create_supplier_claim</field>
            <field name="arch" type="xml">
                <form string="Crear Reclamo a Proveedor" create="false" delete="false">
                    <field name="client_claim_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="claim_type" required="True" readonly="client_claim_id" placeholder="Seleccione el tipo"/>
                        </group>
                        <group>
                            <field name="supplier_id" context="{'default_is_supplier': True, 'default_is_company': True, 'default_company_type': 'company'}" options="{'no_open': True}"/>
                        </group>
                    </group>
                    <group string="Datos del reclamo">
                        <group>
                            <field name="reception_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="purchase_invoice_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="product_id" options="{'no_open': True}"/>
                        </group>
                        <group>
                            <field name="list_price"/>
                            <field name="quantity"/>
                        </group>
                    </group>
                    <separator string="Datos adicionales del reclamo"/>
                    <group>
                        <group/>
                        <group>
                            <field name="observations" placeholder="Notas adicionales sobre el reclamo (opcional)"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_create" type="object" string="Crear Reclamo(s)" class="btn-primary" invisible="not claim_type"/>
                        <button string="Cancelar" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
