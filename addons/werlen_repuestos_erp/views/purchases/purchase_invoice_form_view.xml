<odoo>
    <data>
        <record id="purchase_invoice_form_view" model="ir.ui.view">
            <field name="name">purchase.invoice.form</field>
            <field name="model">purchase_invoice</field>
            <field name="arch" type="xml">
                <form string="Factura de Compra" create="false" edit="true">
                    <header>
                        <field name="state" widget="statusbar" statusbar_visible="pending_delivery,pending_review,in_review,reviewed"/>
                        <button name="action_move_to_pending_review" type="object" string="Marcar como Recibido" class="oe_highlight" invisible="state != 'pending_delivery'" groups="werlen_repuestos_erp.group_reception_control,werlen_repuestos_erp.group_administration"/>
                        <button name="action_start_review" type="object" string="Iniciar Revisión" class="oe_highlight" invisible="state != 'pending_review'" groups="werlen_repuestos_erp.group_reception_control,werlen_repuestos_erp.group_administration"/>
                        <button name="action_finish_review" type="object" string="Finalizar Revisión" class="oe_highlight" invisible="state != 'in_review'" groups="werlen_repuestos_erp.group_reception_control,werlen_repuestos_erp.group_administration"/>
                        <button name="action_revert_to_pending_delivery" type="object" string="Volver a Entrega Pendiente" class="btn btn-outline-danger" invisible="state != 'pending_review'" confirm="¿Está seguro que desea volver la factura a 'Entrega Pendiente'?" groups="werlen_repuestos_erp.group_reception_control,werlen_repuestos_erp.group_administration"/>
                        <button name="action_cancel_review" type="object" string="Cancelar Revisión" class="btn btn-outline-danger" invisible="state != 'in_review'" confirm="¿Está seguro que desea cancelar la revisión? Volverá a 'Revisión Pendiente'." groups="werlen_repuestos_erp.group_reception_control,werlen_repuestos_erp.group_administration"/>
                        <button name="action_reopen_review" type="object" string="Reabrir Revisión" class="btn btn-outline-danger" invisible="state != 'reviewed'" confirm="¿Está seguro que desea reabrir la revisión? Volverá a 'En Revisión'." groups="werlen_repuestos_erp.group_reception_control,werlen_repuestos_erp.group_administration"/>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Falta Recibir" bg_color="bg-warning" invisible="state != 'pending_delivery'"/>
                        <widget name="web_ribbon" title="Falta Revisar" bg_color="bg-danger" invisible="state != 'pending_review'"/>
                        <widget name="web_ribbon" title="En Revisión" bg_color="bg-warning" invisible="state != 'in_review'"/>
                        <widget name="web_ribbon" title="Revisado" bg_color="bg-success" invisible="state != 'reviewed'"/>
                        <h1>
                            FACTURA DE COMPRA
                            <field name="name" class="ms-2 text-muted fw-normal" readonly="1" nolabel="1"/>
                        </h1>
                        <group string="Datos de la factura">
                            <group>
                                <field name="supplier_id" readonly="1" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}" context="{'default_is_supplier': True, 'default_is_company': True, 'default_company_type': 'company'}"/>
                                <field name="name" readonly="1"/>
                            </group>
                            <group>
                                <field name="controlled_datetime_start" readonly="1"/>
                                <field name="controlled_datetime_end" readonly="1"/>
                            </group>
                        </group>
                        <group string="Datos del control">
                            <group>
                                <field name="who_controlled_ids" widget="many2many_tags" readonly="state not in ['in_review', 'reviewed']" options="{'no_create': True, 'no_open': True}"/>
                            </group>
                            <group/>
                        </group>
                        <notebook>
                            <page string="Observaciones">
                                <field name="observations" placeholder="Notas adicionales sobre la factura" nolabel="1"/>
                            </page>
                            <page string="Ingresos" invisible="not reception_ids">
                                <field name="reception_ids" readonly="1" nolabel="1" widget="many2many" mode="list">
                                    <list create="false" delete="false" edit="false">
                                        <field name="name" string="Identificador"/>
                                        <field name="reception_datetime" string="Fecha"/>
                                        <field name="state" string="Estado" widget="badge" decoration-danger="state == 'pending_review'" decoration-warning="state == 'in_review'" decoration-success="state == 'reviewed'"/>
                                        <field name="packages_description" string="Bultos"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>
    </data>
</odoo>
