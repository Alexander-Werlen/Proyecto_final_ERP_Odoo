<odoo>
    <data>
        <record id="return_note_list_view" model="ir.ui.view">
            <field name="name">return.note.list</field>
            <field name="model">return_note</field>
            <field name="arch" type="xml">
                <list string="Notas de Devolución" create="false" delete="false" expand="1">
                    <field name="state" widget="badge" string="Estado" width="120px"
                        decoration-danger="state == 'draft'"
                        decoration-warning="state == 'prepared'"
                        decoration-info="state == 'sent'"
                        decoration-success="state == 'closed'"/>
                    <field name="name" string="Identificador" optional="show"/>
                    <field name="supplier_id" string="Proveedor"/>
                    <field name="date" string="Fecha" optional="show"/>
                    <field name="package_count" string="Bultos" optional="show"/>
                    <field name="carrier_id" string="Transportista" optional="show"/>
                    <field name="observations" string="Observaciones" optional="show"/>
                </list>
            </field>
        </record>

        <record id="return_note_search_view" model="ir.ui.view">
            <field name="name">return.note.search</field>
            <field name="model">return_note</field>
            <field name="arch" type="xml">
                <search string="Nota de Devolución">
                    <field name="name"/>
                    <field name="supplier_id"/>
                    <field name="observations"/>
                    <filter name="draft" string="Borrador" domain="[('state', '=', 'draft')]"/>
                    <filter name="prepared" string="Preparada" domain="[('state', '=', 'prepared')]"/>
                    <filter name="sent" string="Enviada" domain="[('state', '=', 'sent')]"/>
                    <filter name="closed" string="Cerrada" domain="[('state', '=', 'closed')]"/>
                    <filter name="pending" string="Pendientes" domain="[('state', 'in', ['draft', 'prepared', 'sent'])]"/>
                    <group expand="0" string="Agrupar por">
                        <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                        <filter name="group_supplier" string="Proveedor" context="{'group_by': 'supplier_id'}"/>
                        <filter name="group_date" string="Fecha" context="{'group_by': 'date'}"/>
                    </group>
                </search>
            </field>
        </record>
    </data>
</odoo>
