<odoo>
    <record id="return_note_form_view" model="ir.ui.view">
        <field name="name">return.note.form</field>
        <field name="model">return_note</field>
        <field name="arch" type="xml">
            <form string="Nota de devolución" create="false" delete="false">
                <header>
                    <button name="action_open_associate_claim" type="object" string="Asociar reclamo"
                        invisible="state != 'draft'" groups="werlen_repuestos_erp.group_administration"/>
                    <button name="action_prepare" type="object" string="Preparar" class="oe_highlight"
                        invisible="state != 'draft'" groups="werlen_repuestos_erp.group_administration"/>
                    <button name="action_send" type="object" string="Enviar" class="oe_highlight"
                        invisible="state != 'prepared'"
                        groups="werlen_repuestos_erp.group_reception,werlen_repuestos_erp.group_administration"/>
                    <button name="action_close" type="object" string="Cerrar" class="oe_highlight"
                        invisible="state != 'sent'"
                        groups="werlen_repuestos_erp.group_reception,werlen_repuestos_erp.group_administration"/>
                    <button name="action_reopen" type="object" string="Reabrir"
                        invisible="state != 'closed'" groups="werlen_repuestos_erp.group_administration"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,prepared,sent,closed"/>
                </header>
                <sheet>
                    <h1>NOTA DE DEVOLUCIÓN A PROVEEDOR</h1>
                    <group string="Datos de la nota">
                        <group><field name="name" readonly="1"/><field name="date" readonly="1"/>
                            <field name="supplier_id" readonly="1"/><field name="carrier_id" readonly="1"/></group>
                        <group><field name="package_count" readonly="state != 'draft'"/>
                            <field name="who_created_id" readonly="1"/><field name="creation_date" readonly="1"/>
                            <field name="preparation_datetime" readonly="1"/><field name="sent_datetime" readonly="1"/></group>
                    </group>
                    <separator string="Líneas de devolución"/>
                    <field name="line_ids" readonly="state != 'draft'">
                        <list editable="bottom" create="false" delete="false">
                            <field name="display_name" readonly="1"/>
                            <field name="claim_id" readonly="1"/>
                            <field name="product_code"/>
                            <field name="product_description"/>
                            <field name="reason"/>
                            <field name="quantity"/>
                            <field name="state" readonly="1"/>
                        </list>
                    </field>
                    <separator string="Observaciones"/><field name="observations" nolabel="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
