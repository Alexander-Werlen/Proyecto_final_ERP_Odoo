<odoo>
    <data>
        <record id="return_line_form_view" model="ir.ui.view">
            <field name="name">return.line.form</field>
            <field name="model">return_line</field>
            <field name="arch" type="xml">
                <form string="Línea de devolución" create="false" edit="false" delete="false">
                    <header>
                        <field name="state" widget="statusbar" statusbar_visible="draft,sent,accepted,rejected"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="display_name" readonly="1" nolabel="1"/></h1>
                        </div>
                        <group string="Devolución">
                            <group>
                                <field name="return_note_id" readonly="1"/>
                                <field name="claim_id" readonly="1"/>
                                <field name="resolution_date" readonly="1"/>
                            </group>
                            <group>
                                <field name="quantity" readonly="1"/>
                                <field name="state" widget="badge" readonly="1"/>
                            </group>
                        </group>
                        <group string="Producto">
                            <group>
                                <field name="product_code" readonly="1"/>
                                <field name="reason" readonly="1"/>
                            </group>
                            <group>
                                <field name="product_description" readonly="1"/>
                            </group>
                        </group>
                        <group string="Observaciones">
                            <field name="observations" readonly="1" nolabel="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
