<odoo>
    <record id="wizard_send_return_note_form_view" model="ir.ui.view">
        <field name="name">wizard.send.return.note.form</field>
        <field name="model">wizard_send_return_note</field>
        <field name="arch" type="xml">
            <form string="Enviar nota de devolución">
                <group><field name="return_note_id"/><field name="observations"/></group>
                <footer><button name="action_send" type="object" string="Enviar" class="oe_highlight"/>
                    <button string="Cancelar" special="cancel"/></footer>
            </form>
        </field>
    </record>
</odoo>
