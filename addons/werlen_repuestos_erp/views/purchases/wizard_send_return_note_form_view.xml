<odoo>
    <data>
        <record id="wizard_send_return_note_form_view" model="ir.ui.view">
            <field name="name">wizard.send.return.note.form</field>
            <field name="model">wizard_send_return_note</field>
            <field name="arch" type="xml">
                <form string="Enviar nota de devolución" create="false" delete="false">
                    <field name="return_note_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="supplier_id" string="Proveedor" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="package_count" readonly="1"/>
                        </group>
                        <group>
                            <field name="carrier_id" readonly="1"/>
                        </group>
                    </group>
                    <separator string="Observaciones"/>
                    <field name="observations" placeholder="Notas adicionales para el envío" nolabel="1"/>
                    <footer>
                        <button name="action_send" type="object" string="Enviar" class="oe_highlight"/>
                        <button string="Cancelar" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
