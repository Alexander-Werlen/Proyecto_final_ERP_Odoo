<?xml version="1.0" encoding="UTF-8"?>
<odoo>
   <data>
        <record id="base_category" model="ir.module.category">
            <field name="name">Werlen ERP</field>
            <field name="sequence">1</field>
        </record>

        <record model="res.groups" id="group_sales">
            <field name="name">Ventas</field>
            <field name="category_id" ref="werlen_repuestos_erp.base_category"/>
            <field name="implied_ids" 
            eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record model="res.groups" id="group_sales_meli">
            <field name="name">Ventas (MercadoLibre)</field>
            <field name="category_id" ref="werlen_repuestos_erp.base_category"/>
            <field name="implied_ids" 
            eval="[(4, ref('werlen_repuestos_erp.group_sales'))]"/>
        </record>

        <record model="res.groups" id="group_manage_account_payments">
            <field name="name">Control de Ingresos a Cuenta Corriente</field>
            <field name="category_id" ref="werlen_repuestos_erp.base_category"/>
            <field name="implied_ids" 
            eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record model="res.groups" id="group_accountant">
            <field name="name">Caja</field>
            <field name="category_id" ref="werlen_repuestos_erp.base_category"/>
            <field name="implied_ids" 
            eval="[
                (4, ref('base.group_user')),
                (4, ref('werlen_repuestos_erp.group_manage_account_payments'))
            ]"/>
        </record>

        <record model="res.groups" id="group_administration">
            <field name="name">Administración</field>
            <field name="category_id" ref="werlen_repuestos_erp.base_category"/>
            <field name="implied_ids" 
            eval="[
            (4, ref('base.group_user')), 
            (4,ref('base.group_partner_manager')),
            (4,ref('werlen_repuestos_erp.group_accountant'))
            ]"/>
        </record>

        <record model="res.groups" id="group_reception">
            <field name="name">Recepción</field>
            <field name="category_id" ref="werlen_repuestos_erp.base_category"/>
            <field name="implied_ids" 
            eval="[(4, ref('base.group_user'))]"
            />
        </record>

        <record model="res.groups" id="group_reception_control">
            <field name="name">Control Recepción</field>
            <field name="category_id" ref="werlen_repuestos_erp.base_category"/>
            <field name="implied_ids" 
            eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record model="res.groups" id="group_preparation">
            <field name="name">Preparación</field>
            <field name="category_id" ref="werlen_repuestos_erp.base_category"/>
            <field name="implied_ids" 
            eval="[(4, ref('base.group_user'))]"/>
        </record>
       
        <record model="res.groups" id="group_management">
            <field name="name">Gerencia</field>
            <field name="category_id" ref="werlen_repuestos_erp.base_category"/>
            <field name="implied_ids" 
            eval="[
            (4, ref('base.group_user')),
            (4, ref('base.group_partner_manager')),
            (4, ref('werlen_repuestos_erp.group_accountant')), 
            (4, ref('werlen_repuestos_erp.group_sales_meli')),
            (4, ref('werlen_repuestos_erp.group_administration')),
            (4, ref('werlen_repuestos_erp.group_reception')),
            (4, ref('werlen_repuestos_erp.group_preparation')),
            (4, ref('werlen_repuestos_erp.group_reception_control'))
            ]"
            />
        </record>
        
        <record model="res.groups" id="group_system">
            <field name="name">Sistema</field>
            <field name="category_id" ref="werlen_repuestos_erp.base_category"/>
            <field name="implied_ids" 
            eval="[
            (4, ref('base.group_user')),
            (4, ref('base.group_partner_manager'))
            ]"
            />
        </record>

   </data>
</odoo>
