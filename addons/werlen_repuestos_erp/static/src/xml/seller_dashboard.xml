<templates xml:space="preserve">
    <t t-name="werlen_repuestos_erp.SellerDashboard">
        <div class="dashboard-wrapper">

            <t t-if="state.loading">
                <div class="dashboard-skeleton">
                    <div class="skeleton-header skeleton-shimmer"></div>
                    <div class="skeleton-card">
                        <div class="skeleton-legend skeleton-shimmer"></div>
                        <div class="skeleton-bars">
                            <div class="skeleton-bar skeleton-shimmer"></div>
                            <div class="skeleton-bar skeleton-shimmer"></div>
                            <div class="skeleton-bar skeleton-shimmer"></div>
                            <div class="skeleton-bar skeleton-shimmer"></div>
                        </div>
                    </div>
                </div>
            </t>

            <t t-else="">
                <div class="dashboard-title-row">
                    <h2>
                        Vendedor · Estado de mis Ventas
                        <span class="dashboard-user">
                            (<t t-esc="state.userName"/>)
                        </span>
                    </h2>
                    <div class="dashboard-actions">
                        <button type="button"
                                class="btn btn-primary"
                                t-on-click="onOpenRelevantInvoicesClick">
                            Ver ventas relevantes
                        </button>

                        <button type="button"
                                class="btn btn-outline-secondary"
                                t-on-click="onCreateInvoiceClick">
                            Crear Factura (Manual)
                        </button>
                    </div>
                </div>

                <div class="dashboard-card">
                    <div class="dashboard-legend-top">
                        <span class="legend-item unpaid">No pagado</span>
                        <span class="legend-item partial">Parcial</span>
                        <span class="legend-item paid">Pagado</span>
                        <span class="legend-item account">Cta. Cte.</span>
                    </div>

                    <div class="dashboard-sales-container">
                        <div class="dashboard-columns" t-att-class="{ 'is-first-load': state.isFirstLoad }">
                            <t t-foreach="state.columns" t-as="col" t-key="col.key">
                                <div class="dashboard-column" t-att-style="'--col-index: ' + col_index">

                                    <div class="column-bar" t-on-click="() => this.onColumnClick(col)">
                                        <t t-foreach="col.segments" t-as="seg" t-key="seg.key">
                                            <div class="bar-segment"
                                                t-att-class="seg.css"
                                                t-att-style="'height:' + seg.height + '%; z-index: ' + seg.zIndex + '; --seg-index: ' + seg_index"
                                                >
                                                <span class="segment-count"
                                                      t-if="col.total > seg.count and seg.count > 0"
                                                      t-esc="seg.count"/>
                                                <div class="segment-tooltip"
                                                     t-if="seg.count > 0">
                                                    <t t-esc="seg.count"/> facturas (<t t-esc="seg.label"/>)
                                                </div>
                                            </div>
                                        </t>
                                    </div>

                                    <div class="column-total">
                                        <t t-esc="col.displayTotal !== undefined ? col.displayTotal : col.total"/>
                                    </div>

                                    <div class="column-label">
                                        <t t-esc="col.label"/>
                                    </div>


                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </t>

        </div>

    </t>
</templates>
