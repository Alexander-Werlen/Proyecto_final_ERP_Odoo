<templates xml:space="preserve">
    <t t-name="werlen_repuestos_erp.AccountantDashboard">
        <div class="dashboard-wrapper">

            <t t-if="state.loading">
                <div class="dashboard-skeleton">
                    <div class="skeleton-header skeleton-shimmer"></div>
                    <div class="skeleton-card">
                        <div class="skeleton-legend skeleton-shimmer"></div>
                        <div class="skeleton-bars">
                            <div class="skeleton-bar skeleton-shimmer"></div>
                            <div class="skeleton-bar skeleton-shimmer"></div>
                            <div class="skeleton-bar skeleton-shimmer"></div>
                            <div class="skeleton-bar skeleton-shimmer"></div>
                        </div>
                    </div>
                    <div class="skeleton-card">
                        <div class="skeleton-chips">
                            <div class="skeleton-chip skeleton-shimmer"></div>
                            <div class="skeleton-chip skeleton-shimmer"></div>
                            <div class="skeleton-chip skeleton-shimmer"></div>
                        </div>
                    </div>
                </div>
            </t>

            <t t-else="">
                <div class="dashboard-title-row">
                    <h2>
                        Caja · Estado de las Ventas
                        <span class="dashboard-user">
                            (<t t-esc="state.userName"/>)
                        </span>
                    </h2>
                    <t t-if="state.sessionInfo and state.sessionInfo.has_open_session">
                        <div class="dashboard-actions">
                            <button type="button"
                                    class="btn btn-primary"
                                    t-on-click="onOpenRelevantInvoicesClick">
                                Ver Ventas relevantes
                            </button>

                            <button type="button"
                                    class="btn btn-primary position-relative"
                                    t-on-click="onOpenRelevantCreditNotesClick">
                                Ver NC relevantes

                                <t t-if="state.unreconciledCreditNotesCount">
                                    <span class="position-absolute top-0 start-100 translate-middle
                                                d-inline-flex align-items-center justify-content-center
                                                rounded-circle bg-warning text-dark fw-bold px-2"
                                        style="height: 22px; min-width: 22px; font-size: 12px;">
                                        <t t-esc="state.unreconciledCreditNotesCount"/>
                                    </span>
                                </t>
                            </button>

                            <button type="button"
                                    class="btn btn-primary"
                                    t-on-click="onOpenRelevantAccountPaymentsClick">
                                Ver Recibos relevantes
                            </button>
                        </div>
                    </t>
                </div>

                <t t-if="state.sessionInfo and state.sessionInfo.is_over_24h">
                    <div class="session-alert-overdue">
                        <span class="alert-icon">⏰</span>
                        <span class="alert-text">
                            La caja "<t t-esc="state.selectedJournalName"/>" lleva abierta <t t-esc="state.sessionInfo.hours_open"/> horas. Considerá cerrarla.
                        </span>
                    </div>
                </t>

                <t t-if="state.sessionInfo and state.sessionInfo.has_open_session">
                    <div class="dashboard-card">
                        <div class="dashboard-legend-top">
                            <span class="legend-item unpaid">No pagado</span>
                            <span class="legend-item partial">Parcial</span>
                            <span class="legend-item paid">Pagado</span>
                            <span class="legend-item account">Cta. Cte.</span>
                        </div>

                        <div class="dashboard-sales-container">
                            <div class="dashboard-columns" t-att-class="{ 'is-first-load': state.isFirstLoad }">
                                <t t-foreach="state.columns" t-as="col" t-key="col.key">
                                    <div class="dashboard-column" t-att-style="'--col-index: ' + col_index">

                                        <div class="column-bar" t-on-click="() => this.onColumnClick(col)">
                                            <t t-foreach="col.segments" t-as="seg" t-key="seg.key">
                                                <div class="bar-segment"
                                                    t-att-class="seg.css"
                                                    t-att-style="'height:' + seg.height + '%; z-index: ' + seg.zIndex + '; --seg-index: ' + seg_index"
                                                    >
                                                    <span class="segment-count"
                                                          t-if="col.total > seg.count and seg.count > 0"
                                                          t-esc="seg.count"/>
                                                    <div class="segment-tooltip"
                                                         t-if="seg.count > 0">
                                                        <t t-esc="seg.count"/> facturas (<t t-esc="seg.label"/>)
                                                    </div>
                                                </div>
                                            </t>
                                        </div>

                                        <div class="column-total">
                                            <t t-esc="col.displayTotal !== undefined ? col.displayTotal : col.total"/>
                                        </div>

                                        <div class="column-label">
                                            <t t-esc="col.label"/>
                                        </div>


                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </t>
                <t t-else="">
                    <div class="dashboard-card session-closed-card">
                        <div class="session-closed-inner">
                            <div class="overlay-icon">🔒</div>
                            <h3>La caja "<t t-esc="state.selectedJournalName"/>" está cerrada</h3>
                            <p>No se pueden registrar movimientos ni confirmar pagos.</p>
                            <button type="button" class="btn btn-primary btn-lg btn-pulse" t-on-click="onOpenCreateCashSessionClick">
                                Abrir Caja
                            </button>
                        </div>
                    </div>
                </t>

                <div class="dashboard-card">
                    <div class="cash-header">
                        <h3>Movimientos de caja (últimos 7)</h3>

                        <div class="cash-actions">
                            <select class="form-select w-auto"
                                    t-model="state.selectedJournalId"
                                    t-on-change="onJournalChange">

                                <t t-foreach="state.journals" t-as="j" t-key="j.id">
                                    <option t-att-value="j.id">
                                        <t t-esc="j.name"/>
                                    </option>
                                </t>

                            </select>

                            <t t-if="state.sessionInfo and state.sessionInfo.has_open_session">
                                <button type="button"
                                        class="btn btn-outline-secondary"
                                        t-on-click="onManualInPaymentClick">
                                    + Ingreso
                                </button>

                                <button type="button"
                                        class="btn btn-outline-secondary"
                                        t-on-click="onManualOutPaymentClick">
                                    - Egreso
                                </button>
                            </t>
                        </div>
                    </div>

                    <div class="cash-movements-row" t-att-class="{ 'is-first-load': state.isFirstLoad }">

                        <t t-foreach="state.payments" t-as="p" t-key="p.id">

                            <div class="movement-chip"
                                t-on-click="() => this.onOpenPayment(p)"
                                t-att-class="{
                                    'incoming': !p.is_outgoing,
                                    'outgoing': p.is_outgoing,
                                    'other-user': p.is_other_user
                                }"
                                t-att-style="'--chip-index: ' + p_index">

                                <!-- Línea 1 -->
                                <div class="line-amount">
                                    <t t-esc="p.is_outgoing ? '-' : '+'"/>
                                    $<t t-esc="formatAmount(p.amount)"/>
                                </div>

                                <!-- Línea 2 -->
                                <div class="line-method">
                                    <t t-esc="p.method"/>
                                </div>

                                <!-- Línea 3 -->
                                <div class="line-origin">
                                    <t t-esc="p.origin"/>
                                    <span class="desc">
                                        · <t t-esc="p.description or '—'"/>
                                    </span>
                                </div>

                                <!-- Línea 4 -->
                                <div class="line-meta">
                                    <span><t t-esc="p.confirmed_by"/></span>
                                    <span class="time"><t t-esc="p.time"/></span>
                                </div>

                            </div>

                        </t>

                    </div>

                </div>
            </t>

        </div>
    </t>
</templates>
