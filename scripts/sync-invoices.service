[Unit]
Description=Sync invoices from external SMB server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/path/to/Repo
Environment="PYTHONUNBUFFERED=1"
ExecStart=/usr/bin/python3 /path/to/Repo/scripts/sync_invoices.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
